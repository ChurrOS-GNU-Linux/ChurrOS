#!/usr/bin/env bash
#
# churros-write-root-config — aplica un ajuste concreto de /etc pedido desde
# la sesión del usuario (Ajustes → Usuarios y login).
#
# Uso:
#   churros-write-root-config greetd-autologin on|off
#   churros-write-root-config lightdm-autologin on|off
#   churros-write-root-config regreet-greeting "texto"
#   churros-write-root-config greeter-set CLAVE=VALOR [CLAVE=VALOR...]
#
# No acepta contenido libre: cada operación genera su fichero. Antes leía el
# fichero entero de stdin y escribía /etc/greetd/config.toml tal cual, y ese
# fichero decide qué usuario y qué comando arranca greetd ([initial_session]).
#
#   - El usuario del inicio automático es siempre quien invocó pkexec
#     (PKEXEC_UID), nunca un argumento.
#   - El comando de sesión sale de /etc/churros-edition con la tabla de
#     edition-session.sh, la misma que usa la instalación
#     (configure-greetd-session).
#   - El saludo es un texto corto sin caracteres de control, escapado para
#     TOML.
#   - greeter-set solo acepta claves conocidas con valores de una lista o un
#     patrón cerrado (docs/login-greeter.md). Guarda el estado en
#     /etc/greetd/churros-greeter.conf y reescribe solo las líneas de
#     regreet.css marcadas con "churros:<clave>" y el formato del reloj.
#   - El fondo de la pantalla de inicio no pasa por aquí: lo escribe la
#     sesión del usuario en /var/lib/churros/greeter (grupo wheel, ver
#     tmpfiles.d/churros-greeter.conf), sin root.
#   - Cada escritura es atómica: temporal en el directorio de destino y
#     rename.
#
# Se ejecuta como root vía churros-pkexec; la regla polkit
# 50-churros-store.rules pide la contraseña de administrador (auth_admin_keep).

set -euo pipefail
export LC_ALL=C

PROG="${0##*/}"

GREETD_CONF=/etc/greetd/config.toml
REGREET_CONF=/etc/greetd/regreet.toml
REGREET_CSS=/etc/greetd/regreet.css
GREETER_CONF=/etc/greetd/churros-greeter.conf
LIGHTDM_AUTOLOGIN=/etc/lightdm/lightdm.conf.d/autologin.conf
EDITION_LIB=/usr/share/churros/scripts/edition-session.sh

GREETING_MAX_CHARS=80

die() { printf '%s: ERROR: %s\n' "$PROG" "$*" >&2; exit 1; }

usage() {
    cat >&2 <<EOF
Uso: $PROG greetd-autologin on|off
     $PROG lightdm-autologin on|off
     $PROG regreet-greeting "texto"
     $PROG greeter-set CLAVE=VALOR [CLAVE=VALOR...]
EOF
    exit 2
}

# shellcheck source=../../share/churros/scripts/edition-session.sh
. "$EDITION_LIB"

# ------------------------------------------------------------------ helpers

# Escribe CONTENIDO en DESTINO de forma atómica: temporal en el mismo
# directorio (mktemp lo crea con 0600) y rename. Así no hay carreras con
# symlinks en /tmp y quien lee el fichero nunca lo ve a medias.
write_file() {
    local target="$1" content="$2" dir tmp
    dir="${target%/*}"
    install -d -m 0755 "$dir"
    tmp="$(mktemp "$dir/.churros-cfg.XXXXXX")"
    # shellcheck disable=SC2064  # $tmp se expande ahora a propósito
    trap "rm -f -- '$tmp'" EXIT
    printf '%s\n' "$content" > "$tmp"
    chmod 0644 "$tmp"
    mv -f -- "$tmp" "$target"
    trap - EXIT
}

on_off() {
    case "$1" in
        on|off) ;;
        *) usage ;;
    esac
}

# Usuario que pidió el cambio: el que invocó pkexec. sudo deja SUDO_UID.
autologin_user() {
    local uid="${PKEXEC_UID:-${SUDO_UID:-}}" entry name
    [ -n "$uid" ] || die "no se sabe qué usuario lo pide: ejecútalo con churros-pkexec"
    case "$uid" in
        ''|*[!0-9]*) die "uid inválido: $uid" ;;
    esac
    [ "$uid" -ne 0 ] || die "no se configura el inicio automático de root"
    entry="$(getent passwd "$uid")" || die "no existe ningún usuario con uid $uid"
    name="${entry%%:*}"
    # Solo caracteres de nombre de usuario: nada que haya que escapar en TOML
    # ni en INI.
    [[ "$name" =~ ^[A-Za-z0-9_.][A-Za-z0-9_.-]*[$]?$ ]] \
        || die "nombre de usuario no admitido: $name"
    printf '%s\n' "$name"
}

# Cadena básica de TOML: se escapan \ y ". Los caracteres de control ya se
# han rechazado antes.
toml_string() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    printf '"%s"\n' "$s"
}

# Escribe por stdout el TOML de stdin con CLAVE = VALOR en la tabla [SECCION]:
# reemplaza la clave si existe y, si no, la añade al final de la tabla (o
# crea la tabla). El resto del fichero queda igual. VALOR va ya en sintaxis
# TOML (toml_string).
toml_set() {
    SECTION="$1" KEY="$2" VALUE="$3" awk '
        function table(line,   name) {
            if (line !~ /^[ \t]*\[[^][]*\][ \t]*(#.*)?$/) {
                return ""
            }
            name = line
            sub(/^[ \t]*\[[ \t]*/, "", name)
            sub(/[ \t]*\].*$/, "", name)
            return name
        }
        BEGIN {
            section = ENVIRON["SECTION"]
            key = ENVIRON["KEY"]
            value = ENVIRON["VALUE"]
            current = ""
            done = 0
        }
        {
            name = table($0)
            if (name != "") {
                if (current == section && !done) {
                    print key " = " value
                    done = 1
                }
                current = name
                print
                next
            }
            if (current == section && !done && $0 ~ ("^[ \t]*" key "[ \t]*=")) {
                print key " = " value
                done = 1
                next
            }
            print
        }
        END {
            if (!done) {
                if (current != section) {
                    if (NR > 0) {
                        print ""
                    }
                    print "[" section "]"
                }
                print key " = " value
            }
        }
    '
}

# Contenido actual de un fichero, o vacío si no existe.
current_content() {
    if [ -f "$1" ]; then
        cat -- "$1"
    fi
}

# --------------------------------------------------------------- operaciones

set_greetd_autologin() {
    local state="$1" edition session user=""
    on_off "$state"
    edition="$(churros_edition)"
    session="$(churros_session_command "$edition")" || session=""
    if [ "$state" = on ]; then
        [ -n "$session" ] || die "la edición $edition no tiene sesión gráfica"
        user="$(autologin_user)"
    fi
    write_file "$GREETD_CONF" "$(churros_greetd_config "$session" "$user")"
}

set_lightdm_autologin() {
    local state="$1" edition session user
    on_off "$state"
    if [ "$state" = off ]; then
        rm -f -- "$LIGHTDM_AUTOLOGIN"
        return
    fi
    edition="$(churros_edition)"
    session="$(churros_lightdm_session "$edition")" \
        || die "la edición $edition no tiene sesión gráfica"
    user="$(autologin_user)"
    write_file "$LIGHTDM_AUTOLOGIN" "[Seat:*]
autologin-user=$user
autologin-user-timeout=0
autologin-session=$session"
}

set_regreet_greeting() {
    local text="$1" chars content
    [ -n "$text" ] || die "el saludo no puede estar vacío"
    case "$text" in
        # Sin saltos de línea ni otros controles: en TOML abrirían otra clave.
        *[[:cntrl:]]*) die "el saludo no puede contener caracteres de control" ;;
    esac
    printf '%s' "$text" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 \
        || die "el saludo no es UTF-8 válido"
    chars="$(printf '%s' "$text" | LC_ALL=C.UTF-8 wc -m)"
    [ "$chars" -le "$GREETING_MAX_CHARS" ] \
        || die "el saludo admite como máximo $GREETING_MAX_CHARS caracteres"

    content="$(current_content "$REGREET_CONF" | toml_set appearance greeting_msg "$(toml_string "$text")")"
    write_file "$REGREET_CONF" "$content"
}

# ------------------------------------------------- pantalla de inicio

# Valores por defecto: los del regreet.css y regreet.toml de la ISO.
declare -A GREETER_DEFAULTS=(
    [dim]=48 [avatar]=on [accent]=#F97316
    [clock]=24 [seconds]=off [date]=on [clock_size]=medium
    [date_pattern]="%A, %-d %B"
)
AVATAR_IMAGE='url("file:///usr/share/pixmaps/churros-logo.png"), radial-gradient(circle closest-side, rgba(255, 255, 255, 0.20) 96%, rgba(255, 255, 255, 0) 100%)'

# Valida CLAVE=VALOR; muere si la clave no existe o el valor no vale.
greeter_check() {
    local key="$1" value="$2"
    case "$key" in
        dim)
            if ! [[ "$value" =~ ^[0-9]{1,2}$ ]] || [ "$value" -gt 80 ]; then
                die "dim: de 0 a 80 (% de oscurecido): $value"
            fi ;;
        avatar|seconds|date)
            [[ "$value" =~ ^(on|off)$ ]] || die "$key: on u off: $value" ;;
        accent)
            [[ "$value" =~ ^#[0-9A-Fa-f]{6}$ ]] || die "accent: color #RRGGBB: $value" ;;
        clock)
            [[ "$value" =~ ^(12|24)$ ]] || die "clock: 12 o 24: $value" ;;
        clock_size)
            [[ "$value" =~ ^(small|medium|large)$ ]] || die "clock_size: small, medium o large: $value" ;;
        date_pattern)
            # Lo pone configure-greeter-locale al instalar (root, sin pkexec).
            [ -z "${PKEXEC_UID:-}" ] || die "date_pattern solo se fija al instalar"
            [[ "$value" =~ ^[%A-Za-z0-9\ .,-]{1,40}$ ]] || die "date_pattern no admitido: $value" ;;
        *) die "clave desconocida: $key" ;;
    esac
}

# Lee el estado guardado sobre los valores por defecto.
greeter_load() {
    local line key value
    for key in "${!GREETER_DEFAULTS[@]}"; do
        GREETER["$key"]="${GREETER_DEFAULTS[$key]}"
    done
    [ -f "$GREETER_CONF" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in ''|'#'*) continue ;; esac
        key="${line%%=*}"
        value="${line#*=}"
        # Una línea inválida (editada a mano) se ignora: vale el defecto.
        [ -n "${GREETER_DEFAULTS[$key]+x}" ] || continue
        ( greeter_check "$key" "$value" ) 2>/dev/null || continue
        GREETER["$key"]="$value"
    done < "$GREETER_CONF"
}

# Reescribe el valor de las líneas de regreet.css que acaban en
# "/* churros:CLAVE */". Las demás quedan igual.
css_set() {
    KEY="$1" VALUE="$2" awk '
        BEGIN { tag = "; /* churros:" ENVIRON["KEY"] " */" }
        substr($0, length($0) - length(tag) + 1) == tag {
            if ($0 ~ /^@define-color /) {
                split($0, f, " ")
                print f[1] " " f[2] " " ENVIRON["VALUE"] tag
            } else {
                print substr($0, 1, index($0, ":")) " " ENVIRON["VALUE"] tag
            }
            next
        }
        { print }
    '
}

# Formato del reloj (marcado Pango, regreet.toml): fecha opcional encima y
# la hora grande. Ningún valor lleva comillas ni barras (greeter_check), así
# que la cadena TOML se escribe tal cual, con su \n.
clock_format() {
    local time size fmt=""
    if [ "${GREETER[clock]}" = 12 ]; then time="%-I:%M"; else time="%H:%M"; fi
    [ "${GREETER[seconds]}" = off ] || time="$time:%S"
    [ "${GREETER[clock]}" = 24 ] || time="$time %p"
    case "${GREETER[clock_size]}" in
        small) size=56pt ;;
        large) size=88pt ;;
        *) size=72pt ;;
    esac
    if [ "${GREETER[date]}" = on ]; then
        fmt="<span size='15pt' weight='600'>${GREETER[date_pattern]}</span>\\n"
    fi
    fmt="$fmt<span size='$size' weight='bold' font_features='tnum' letter_spacing='-2048'>$time</span>"
    printf '"%s"\n' "$fmt"
}

set_greeter() {
    local pair key value css opacity
    declare -gA GREETER=()
    greeter_load
    [ "$#" -ge 1 ] || usage
    for pair in "$@"; do
        case "$pair" in
            *=*) ;;
            *) die "se espera CLAVE=VALOR: $pair" ;;
        esac
        key="${pair%%=*}"
        value="${pair#*=}"
        greeter_check "$key" "$value"
        GREETER["$key"]="$value"
    done

    if [ "${GREETER[dim]}" -eq 0 ]; then
        opacity=1
    else
        opacity="$(printf '0.%02d' $((100 - GREETER[dim])))"
    fi
    css="$(current_content "$REGREET_CSS")"
    [ -n "$css" ] || die "no existe $REGREET_CSS"
    css="$(printf '%s\n' "$css" | css_set accent "${GREETER[accent]}")"
    css="$(printf '%s\n' "$css" | css_set picture-opacity "$opacity")"
    if [ "${GREETER[avatar]}" = on ]; then
        css="$(printf '%s\n' "$css" | css_set avatar-image "$AVATAR_IMAGE")"
        css="$(printf '%s\n' "$css" | css_set avatar-padding 110px)"
    else
        css="$(printf '%s\n' "$css" | css_set avatar-image none)"
        css="$(printf '%s\n' "$css" | css_set avatar-padding 0)"
    fi
    write_file "$REGREET_CSS" "$css"

    write_file "$REGREET_CONF" \
        "$(current_content "$REGREET_CONF" | toml_set widget.clock format "$(clock_format)")"

    local out="# Pantalla de inicio: churros-write-root-config greeter-set (no editar)"
    for key in dim avatar accent clock seconds date clock_size date_pattern; do
        out+=$'\n'"$key=${GREETER[$key]}"
    done
    write_file "$GREETER_CONF" "$out"
}

# --------------------------------------------------------------------- main

[ "$#" -ge 2 ] || usage

case "$1" in
    greeter-set) shift; set_greeter "$@"; exit 0 ;;
esac
[ "$#" -eq 2 ] || usage
case "$1" in
    greetd-autologin)  set_greetd_autologin "$2" ;;
    lightdm-autologin) set_lightdm_autologin "$2" ;;
    regreet-greeting)  set_regreet_greeting "$2" ;;
    *) usage ;;
esac
