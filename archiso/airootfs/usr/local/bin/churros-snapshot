#!/usr/bin/env bash
#
# churros-snapshot — sistema de rollback de ChurrOS con snapshots btrfs.
#
# Crea snapshots de los subvolúmenes @ y @home ANTES de cada transacción de
# pacman (hook PreTransaction) para poder volver atrás si una actualización
# rompe el sistema. Los snapshots viven en el subvolumen @snapshots (nivel
# superior, id=5), aislado de @ para que no haya snapshots anidados.
#
# Uso:
#   churros-snapshot create [RAZON]
#   churros-snapshot list [--json|--plain]
#   churros-snapshot info <stamp>
#   churros-snapshot delete <stamp>
#   churros-snapshot cleanup [--dry-run] [KEEP]   (solo automáticos; --dry-run no borra)
#   churros-snapshot restore [-d DISPOSITIVO] [--sin-home|--con-home] <stamp>
#   churros-snapshot restore            (desde la ISO: guiado, pregunta todo)
#
# restore: intercambia @ (y @home, salvo --sin-home) por los del snapshot. El sistema en marcha no
# puede renombrar el subvolumen raíz montado: hay que arrancar desde la ISO
# live y apuntar al disco instalado con -d.

set -euo pipefail

SNAPSHOTS_DIR="@snapshots"
STAMP_FILE="meta.txt"
KEEP_DEFAULT=5

usage() {
    sed -n '2,21p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

log() { printf 'churros-snapshot: %s\n' "$*" >&2; }
die() { log "ERROR: $*"; exit 1; }

# ------------------------------------------------------------------ helpers

device_of() {
    local mnt="$1" src
    src="$(findmnt -n -o SOURCE "$mnt" 2>/dev/null)" \
        || die "no se pudo resolver el dispositivo de $mnt"
    # findmnt devuelve /dev/sdXn[/@] en btrfs; mount solo admite /dev/sdXn.
    printf '%s\n' "${src%%\[*}"
}

# Razones de los snapshots automáticos: el hook de pacman y el actualizador
# de ChurrOS. Solo esos entran en la retención; los demás (Ajustes «Crear
# snapshot ahora», `create antes-de-algo`...) los creó alguien a propósito y
# no se borran solos (#329).
is_automatic() {
    case "$1" in
        pacman-pre|churros-utils-pre-*) return 0 ;;
        *) return 1 ;;
    esac
}

reason_of() {
    sed -n 's/^reason=//p' "$(snapshot_path "$1")/$STAMP_FILE" 2>/dev/null | head -1
}

is_btrfs() {
    [ "$(findmnt -n -o FSTYPE "${1:-/}" 2>/dev/null)" = "btrfs" ]
}

TOP_MOUNT=""
top_mount() {
    local dev="$1"
    TOP_MOUNT="$(mktemp -d /run/churros-snap.XXXXXX 2>/dev/null || mktemp -d)"
    mount -o subvolid=5 "$dev" "$TOP_MOUNT" \
        || die "no se pudo montar el volumen btrfs ($dev) para gestionar snapshots"
}

top_cleanup() {
    if [ -n "$TOP_MOUNT" ] && mountpoint -q "$TOP_MOUNT"; then
        umount "$TOP_MOUNT" || true
        rmdir "$TOP_MOUNT" 2>/dev/null || true
    fi
    TOP_MOUNT=""
}
trap top_cleanup EXIT

snapshot_path() { printf '%s/%s/%s' "$TOP_MOUNT" "$SNAPSHOTS_DIR" "$1"; }

require_snapshot() {
    [ -d "$(snapshot_path "$1")/root" ] \
        || die "snapshot '$1' no existe (o no tiene subvolumen root)"
}

ensure_root_btrfs() {
    is_btrfs / || die "el sistema de archivos de / no es btrfs (rollback solo soportado en btrfs)"
}

stamp_now() { date +%Y%m%d-%H%M%S; }

# ---------------------------------------------------------------- create

create() {
    local reason="${1:-manual}"
    local dev stamp dir home="no"

    ensure_root_btrfs
    dev="$(device_of /)"
    top_mount "$dev"
    [ -d "$TOP_MOUNT/@" ] || die "no hay subvolumen '@' en $dev"

    # Asegurar el subvolumen contenedor (no montado en el sistema).
    if [ ! -d "$TOP_MOUNT/$SNAPSHOTS_DIR" ]; then
        btrfs subvol create "$TOP_MOUNT/$SNAPSHOTS_DIR" >/dev/null
    fi

    stamp="$(stamp_now)"
    dir="$(snapshot_path "$stamp")"
    mkdir -p "$dir"

    if ! btrfs subvol snapshot -r "$TOP_MOUNT/@" "$dir/root" >/dev/null; then
        rmdir "$dir" 2>/dev/null || true
        die "no se pudo crear el snapshot de @ ($reason): no hay punto de vuelta. Mira el espacio libre con 'sudo btrfs filesystem usage /'"
    fi

    if [ -d "$TOP_MOUNT/@home" ]; then
        if btrfs subvol snapshot -r "$TOP_MOUNT/@home" "$dir/home" >/dev/null 2>&1; then
            home="ok"
        else
            btrfs subvol delete "$dir/root" >/dev/null 2>&1 || true
            rmdir "$dir" 2>/dev/null || true
            die "no se pudo crear el snapshot de @home ($reason): se abortó el snapshot completo y no hay punto de vuelta. Mira el espacio libre con 'sudo btrfs filesystem usage /'"
        fi
    fi

    {
        echo "stamp=$stamp"
        echo "date=$(date '+%Y-%m-%d %H:%M:%S')"
        echo "reason=$reason"
        echo "kernel=$(uname -r 2>/dev/null || echo '?')"
        echo "home=$home"
        echo "packages=$(find /var/lib/pacman/local -mindepth 1 -maxdepth 1 -type d -printf x 2>/dev/null | wc -c)"
    } > "$dir/$STAMP_FILE"

    log "snapshot '$stamp' creado (razón: $reason)"
    cleanup_inner "${KEEP:-$KEEP_DEFAULT}"
}

# ---------------------------------------------------------------- list

list_plain() {
    local n=0 meta stamp reason date
    for meta in "$TOP_MOUNT/$SNAPSHOTS_DIR"/*/"$STAMP_FILE"; do
        [ -f "$meta" ] || continue
        stamp="$(basename "$(dirname "$meta")")"
        reason="$(sed -n 's/^reason=//p' "$meta" | head -1)"
        date="$(sed -n 's/^date=//p' "$meta" | head -1)"
        printf '%-16s  %-22s  %s\n' "$stamp" "$date" "${reason:-?}"
        n=$((n + 1))
    done
    [ "$n" -gt 0 ] || printf '(sin snapshots)\n'
}

list_json() {
    local first=1 meta stamp reason date
    for meta in "$TOP_MOUNT/$SNAPSHOTS_DIR"/*/"$STAMP_FILE"; do
        [ -f "$meta" ] || continue
        stamp="$(basename "$(dirname "$meta")")"
        reason="$(sed -n 's/^reason=//p' "$meta" | head -1)"
        date="$(sed -n 's/^date=//p' "$meta" | head -1)"
        [ "$first" -eq 1 ] || printf ','
        first=0
        esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
        printf '{"stamp":"%s","reason":"%s","date":"%s"}' \
            "$(esc "$stamp")" "$(esc "$reason")" "$(esc "$date")"
    done
}

list_snapshots() {
    local mode="${1:-json}"
    ensure_root_btrfs
    top_mount "$(device_of /)"
    if [ "$mode" = "json" ]; then
        printf '['
        list_json
        printf ']\n'
    else
        list_plain
    fi
}

# ---------------------------------------------------------------- info

info_snapshot() {
    ensure_root_btrfs
    top_mount "$(device_of /)"
    require_snapshot "$1"
    local meta
    meta="$(snapshot_path "$1")/$STAMP_FILE"
    if [ -f "$meta" ]; then
        cat "$meta"
    else
        printf 'stamp=%s\n(reason no registrado)\n' "$1"
    fi
}

# ---------------------------------------------------------------- delete

# Borra un snapshot asumiendo TOP_MOUNT montado. No llama a top_mount.
delete_one() {
    local stamp="$1" dir sub
    require_snapshot "$stamp"
    dir="$(snapshot_path "$stamp")"
    for sub in "$dir"/root "$dir"/home; do
        if [ -d "$sub" ]; then
            btrfs subvol delete "$sub" >/dev/null
        fi
    done
    rm -rf "$dir"
    log "snapshot '$stamp' eliminado"
}

delete_snapshot() {
    ensure_root_btrfs
    top_mount "$(device_of /)"
    delete_one "$1"
}

# ---------------------------------------------------------------- cleanup

# Asume TOP_MOUNT montado; borra los más antiguos hasta dejar KEEP.
# exclusive_bytes STAMP: bytes que solo usa ese snapshot (lo que liberaría
# borrarlo). Lo compartido con @ u otros snapshots no cuenta (#342).
exclusive_bytes() {
    local dir sub total=0 n
    dir="$(snapshot_path "$1")"
    for sub in "$dir/root" "$dir/home"; do
        [ -d "$sub" ] || continue
        n="$(btrfs filesystem du -s --raw "$sub" 2>/dev/null | awk 'NR == 2 { print $2 }')"
        [[ "$n" =~ ^[0-9]+$ ]] && total=$((total + n))
    done
    printf '%s\n' "$total"
}

human_bytes() {
    LC_ALL=C awk -v b="$1" 'BEGIN { split("B KiB MiB GiB TiB", u); i = 1; while (b >= 1024 && i < 5) { b /= 1024; i++ } printf (i == 1 ? "%d %s" : "%.1f %s"), b, u[i] }'
}

# cleanup_inner KEEP [DRY]: con DRY=yes solo enseña qué borraría (#342).
cleanup_inner() {
    local keep="${1:-$KEEP_DEFAULT}" dry="${2:-no}"
    [[ "$keep" =~ ^[0-9]+$ ]] || die "KEEP tiene que ser un número de snapshots automáticos a conservar, no '$keep'"
    if [ ! -d "$TOP_MOUNT/$SNAPSHOTS_DIR" ]; then
        [ "$dry" = yes ] && log "cleanup: no hay snapshots ($SNAPSHOTS_DIR no existe): nada que borrar"
        return 0
    fi

    local stamps=() d stamp manual=0 manuals=()
    for d in "$TOP_MOUNT/$SNAPSHOTS_DIR"/*/; do
        [ -d "$d" ] || continue
        [ -f "${d}${STAMP_FILE}" ] || continue
        stamp="$(basename "$d")"
        if is_automatic "$(reason_of "$stamp")"; then
            stamps+=("$stamp")
        else
            manual=$((manual + 1))
            manuals+=("$stamp")
        fi
    done
    [ "$manual" -gt 0 ] && log "cleanup: $manual snapshots manuales se conservan (se borran con 'churros-snapshot delete')"

    local total=${#stamps[@]}
    if [ "$dry" = yes ]; then
        local s meta freed=0 n drop=()
        [ "$total" -gt "$keep" ] && drop=("${stamps[@]:0:$((total - keep))}")
        echo "Vista previa de 'cleanup $keep' (no se borra nada):"
        for s in "${stamps[@]}"; do
            meta="$(snapshot_path "$s")/$STAMP_FILE"
            if printf '%s\n' "${drop[@]}" | grep -qxF "$s"; then
                n="$(exclusive_bytes "$s")"; freed=$((freed + n))
                printf '  BORRARÍA  %s  %s  automático (%s)  ~%s\n' "$s" "$(sed -n 's/^date=//p' "$meta")" "$(reason_of "$s")" "$(human_bytes "$n")"
            else
                printf '  conserva  %s  %s  automático (%s)\n' "$s" "$(sed -n 's/^date=//p' "$meta")" "$(reason_of "$s")"
            fi
        done
        for s in "${manuals[@]}"; do
            printf '  conserva  %s  %s  manual (%s)\n' "$s" "$(sed -n 's/^date=//p' "$(snapshot_path "$s")/$STAMP_FILE")" "$(reason_of "$s")"
        done
        echo "Se borrarían ${#drop[@]} de $total automáticos; liberaría unos $(human_bytes "$freed") (solo lo exclusivo de cada snapshot)."
        return 0
    fi
    if [ "$total" -le "$keep" ]; then
        log "cleanup: $total snapshots automáticos (máx. $keep) — nada que borrar"
        return 0
    fi

    local s
    for s in "${stamps[@]:0:$((total - keep))}"; do
        delete_one "$s"
    done
    log "cleanup: borrados $((total - keep)) snapshots automáticos (quedan $keep)"
}

cleanup() {
    ensure_root_btrfs
    top_mount "$(device_of /)"
    cleanup_inner "${1:-$KEEP_DEFAULT}" "${2:-no}"
}

# ---------------------------------------------------------------- restore

# restore STAMP DEV [HOME]: HOME=yes también devuelve /home al snapshot (lo de
# antes queda en @home.broken-*); HOME=no deja /home como está (#333).
restore() {
    local stamp="$1" dev="$2" home="${3:-yes}"
    [ -n "$stamp" ] || usage 1

    if [ -z "$dev" ]; then
        ensure_root_btrfs
        dev="$(device_of /)"
    fi

    top_mount "$dev"
    [ -d "$TOP_MOUNT/@" ] || die "no hay subvolumen '@' en $dev"
    require_snapshot "$stamp"

    if [ "$dev" = "$(device_of / 2>/dev/null || echo none)" ]; then
        die "no se puede restaurar el sistema en marcha (raíz montada). Arranca desde la ISO live y ejecuta: churros-snapshot restore -d $dev $stamp"
    fi

    local src backup_stamp
    src="$(snapshot_path "$stamp")"
    backup_stamp="broken-$(date +%Y%m%d-%H%M%S)"

    log "resguardando estado actual como @$backup_stamp"
    mv "$TOP_MOUNT/@" "$TOP_MOUNT/@$backup_stamp"
    btrfs subvol snapshot "$src/root" "$TOP_MOUNT/@" >/dev/null
    # El snapshot se toma en el hook PreTransaction, con pacman ya dentro: lleva
    # su db.lck. Restaurado tal cual, pacman decía «unable to lock database»
    # en cada orden (visto al restaurar desde la ISO en una VM).
    rm -f -- "$TOP_MOUNT/@/var/lib/pacman/db.lck"

    if [ "$home" = yes ] && [ -d "$src/home" ] && [ -d "$TOP_MOUNT/@home" ]; then
        mv "$TOP_MOUNT/@home" "$TOP_MOUNT/@home.$backup_stamp"
        btrfs subvol snapshot "$src/home" "$TOP_MOUNT/@home" >/dev/null
        log "restaurado '$stamp': el sistema (@) y /home (@home) (respaldos: @$backup_stamp, @home.$backup_stamp)"
    else
        log "restaurado '$stamp': solo el sistema (@); /home no se ha tocado (respaldo: @$backup_stamp)"
    fi
    log "reinicia el sistema para completar la restauración"
}

# ---------------------------------------------------------- restore guiado
#
# `churros-snapshot restore` sin snapshot, desde la ISO live (#327): busca
# el sistema instalado, abre LUKS si hace falta, enseña los snapshots en
# solo lectura, explica qué va a pasar y pide confirmación. Restaura con
# restore() de arriba, igual que `restore -d DEV STAMP`, y comprueba el
# resultado. No toca nada hasta que el usuario escribe RESTAURAR.

ask() {
    local answer
    printf '%s ' "$1" >&2
    read -r answer || answer=""
    printf '%s\n' "$answer"
}

# choose TÍTULO OPCIÓN... — imprime el número elegido (1..n).
choose() {
    local title="$1" i=1 n pick
    shift
    n=$#
    printf '\n%s\n' "$title" >&2
    for opt in "$@"; do
        printf '  %d) %s\n' "$i" "$opt" >&2
        i=$((i + 1))
    done
    [ "$n" -eq 1 ] && { printf '1\n'; return; }
    pick="$(ask "Elige un número (1-$n):")"
    case "$pick" in
        ''|*[!0-9]*) die "opción no válida: '$pick'" ;;
    esac
    if [ "$pick" -lt 1 ] || [ "$pick" -gt "$n" ]; then
        die "opción no válida: '$pick'"
    fi
    printf '%s\n' "$pick"
}

RO_MOUNT=""
ro_umount() {
    [ -n "$RO_MOUNT" ] || return 0
    umount "$RO_MOUNT" 2>/dev/null || true
    rmdir "$RO_MOUNT" 2>/dev/null || rm -f "$RO_MOUNT"
    RO_MOUNT=""
}

ro_mount() {
    ro_umount
    RO_MOUNT="$(mktemp -d /run/churros-snap-ro.XXXXXX 2>/dev/null || mktemp -d)"
    if ! mount -o ro,subvolid=5 "$1" "$RO_MOUNT" 2>/dev/null; then
        rmdir "$RO_MOUNT" 2>/dev/null || true
        RO_MOUNT=""
        return 1
    fi
}

# Abrir LUKS no borra nada: solo pide la contraseña y crea /dev/mapper/…
unlock_luks() {
    local part name parts=()
    # La lista primero: dentro de `while read … < <(lsblk)` la pregunta leía
    # su respuesta de lsblk, no del usuario.
    mapfile -t parts < <(lsblk -rpno NAME,FSTYPE 2>/dev/null | awk '$2 == "crypto_LUKS" { print $1 }')
    for part in "${parts[@]}"; do
        [ -n "$part" ] || continue
        # Ya abierto: tiene un hijo de tipo crypt.
        lsblk -rno TYPE "$part" 2>/dev/null | grep -qx crypt && continue
        name="churros-$(basename "$part")"
        case "$(ask "El disco $part está cifrado (LUKS). ¿Abrirlo para buscar el sistema? [s/N]")" in
            s|S|si|sí|Sí|SI) cryptsetup open "$part" "$name" || log "no se pudo abrir $part (¿contraseña?); se sigue sin él" ;;
        esac
    done
}

# Particiones btrfs con @ y @snapshots, sin la raíz en marcha.
installed_systems() {
    local dev running
    running="$(device_of / 2>/dev/null || echo none)"
    while read -r dev; do
        if [ -z "$dev" ] || [ "$dev" = "$running" ]; then
            continue
        fi
        ro_mount "$dev" || continue
        if [ -d "$RO_MOUNT/@" ] && [ -d "$RO_MOUNT/$SNAPSHOTS_DIR" ]; then
            printf '%s\n' "$dev"
        fi
        ro_umount
    done < <(lsblk -rpno NAME,FSTYPE 2>/dev/null | awk '$2 == "btrfs" { print $1 }')
}

meta_value() {
    sed -n "s/^$2=//p" "$1" 2>/dev/null | head -1
}

guided_restore() {
    [ "$(id -u)" -eq 0 ] || die "hace falta root: sudo churros-snapshot restore"
    trap 'ro_umount; top_cleanup' EXIT

    printf 'Restaurar ChurrOS desde un snapshot. Hasta que confirmes, solo se lee el disco.\n' >&2
    unlock_luks

    local systems=() dev stamps=() labels=() meta pick stamp date reason
    mapfile -t systems < <(installed_systems)
    if [ "${#systems[@]}" -eq 0 ]; then
        is_btrfs / && die "esto se hace desde la ISO live: el sistema en marcha no se puede restaurar. Arranca el USB de ChurrOS y repite"
        die "no se encontró ningún ChurrOS instalado en btrfs con snapshots (si el disco está cifrado, ábrelo cuando lo pregunte)"
    fi
    pick="$(choose "Sistema instalado:" "${systems[@]}")"
    dev="${systems[$((pick - 1))]}"

    ro_mount "$dev" || die "no se pudo montar $dev en solo lectura"
    for meta in "$RO_MOUNT/$SNAPSHOTS_DIR"/*/"$STAMP_FILE"; do
        [ -f "$meta" ] || continue
        [ -d "$(dirname "$meta")/root" ] || continue
        stamp="$(basename "$(dirname "$meta")")"
        stamps+=("$stamp")
        labels+=("$(meta_value "$meta" date)  ($(meta_value "$meta" reason), kernel $(meta_value "$meta" kernel))")
    done
    [ "${#stamps[@]}" -gt 0 ] || die "en $dev no hay snapshots"
    pick="$(choose "Snapshots en $dev (el último es el más reciente):" "${labels[@]}")"
    stamp="${stamps[$((pick - 1))]}"
    meta="$RO_MOUNT/$SNAPSHOTS_DIR/$stamp/$STAMP_FILE"
    date="$(meta_value "$meta" date)"
    reason="$(meta_value "$meta" reason)"
    ro_umount

    # /home son los archivos del usuario: por defecto no se tocan (#333).
    local home=no home_line
    case "$(ask "¿Devolver también /home (tus archivos) al $date? Solo si están dañados. [s/N]")" in
        s|S|si|sí|Sí|SI) home=yes ;;
    esac
    if [ "$home" = yes ]; then
        home_line="  - /home TAMBIÉN vuelve al $date. Lo que guardaste después sigue en
    @home.broken-<fecha>: cópialo de ahí antes de borrar ese subvolumen."
    else
        home_line="  - /home NO se toca: tus archivos se quedan como están ahora."
    fi

    cat >&2 <<EOF

Vas a volver al snapshot del $date ($reason) en $dev:
  - El sistema (@) vuelve al $date. El actual NO se borra: pasa a @broken-<fecha>.
$home_line
  - Al terminar, reinicia y quita el USB.
EOF
    [ "$(ask "Escribe RESTAURAR para seguir (cualquier otra cosa cancela):")" = RESTAURAR ] \
        || { log "cancelado: no se ha tocado nada"; exit 0; }

    restore "$stamp" "$dev" "$home"

    # Comprobar el resultado en el disco, no fiarse del mensaje.
    top_cleanup
    ro_mount "$dev" || die "restaurado, pero no se pudo comprobar $dev"
    [ -d "$RO_MOUNT/@" ] || die "tras restaurar no hay @ en $dev: no reinicies y pide ayuda"
    local backups=("$RO_MOUNT"/@broken-*)
    [ -d "${backups[-1]}" ] || die "tras restaurar no está el respaldo @broken-*: no reinicies y pide ayuda"
    log "comprobado: @ es el snapshot del $date y el estado anterior está en $(basename "${backups[-1]}")"
    log "ya puedes reiniciar (quita el USB)"
}

# ---------------------------------------------------------------- main

CMD="${1:-}"
case "$CMD" in
    create)
        shift
        create "${1:-manual}"
        ;;
    list)
        shift
        case "${1:-json}" in
            --plain|-p) list_snapshots plain ;;
            *)          list_snapshots json ;;
        esac
        ;;
    info)
        shift
        [ "$#" -ge 1 ] || usage 1
        info_snapshot "$1"
        ;;
    delete)
        shift
        [ "$#" -ge 1 ] || usage 1
        delete_snapshot "$1"
        ;;
    cleanup)
        shift
        dry=no
        if [ "${1:-}" = --dry-run ]; then
            dry=yes
            shift
        fi
        cleanup "${1:-$KEEP_DEFAULT}" "$dry"
        ;;
    restore)
        shift
        dev=""
        stamp=""
        # Sin opción, restore -d DEV STAMP sigue devolviendo también /home
        # (como siempre y como está documentado); el mensaje dice qué movió.
        home=yes
        while [ "$#" -gt 0 ]; do
            case "$1" in
                -d)
                    [ "$#" -ge 2 ] || usage 1
                    dev="$2"
                    shift 2
                    ;;
                --sin-home)
                    home=no
                    shift
                    ;;
                --con-home)
                    home=yes
                    shift
                    ;;
                *)
                    stamp="$1"
                    shift
                    ;;
            esac
        done
        if [ -z "$stamp" ]; then
            [ -z "$dev" ] || usage 1
            guided_restore
        else
            restore "$stamp" "$dev" "$home"
        fi
        ;;
    ""|-h|--help)
        usage 0
        ;;
    *)
        echo "churros-snapshot: comando desconocido '$CMD'" >&2
        usage 1
        ;;
esac
