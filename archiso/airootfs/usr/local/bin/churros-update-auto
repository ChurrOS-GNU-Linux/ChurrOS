#!/usr/bin/env bash
#
# churros-update-auto — actualizaciones periódicas (timer de systemd).
# Como usuario (escritorio): comprueba y avisa. Como root (servidor): actualiza
# pacman, flatpak y las utilidades vía churros-pkexec y notifica el resultado.
#
# Los programas van por ruta absoluta: la regla polkit los autoriza por ruta
# exacta y argv exacto. Instalar paquetes pide contraseña de administrador
# (auth_admin_keep), así que desde el timer de usuario, sin agente de polkit,
# estos pasos fallan; ver #142 (comprobar y notificar en vez de instalar).
#

# Escritorio: el timer de usuario (skel) solo COMPRUEBA y avisa; instalar es
# siempre un gesto del usuario en Ajustes > Actualizaciones (con contraseña).
# Antes intentaba instalar sin agente de polkit: fallaba cada día y avisaba de
# un "Fallo en la actualización" que no lo era (#142).
if [ "$(id -u)" -ne 0 ]; then
    pending=0
    parts=()
    if command -v checkupdates >/dev/null 2>&1; then
        # checkupdates: base de datos temporal, sin root. Sale con 2 si no hay nada.
        n="$(checkupdates 2>/dev/null | wc -l)"
        if [ "${n:-0}" -gt 0 ]; then pending=$((pending + n)); parts+=("$n del sistema"); fi
    fi
    if command -v flatpak >/dev/null 2>&1; then
        n="$(flatpak remote-ls --updates --columns=application 2>/dev/null | grep -c . || true)"
        if [ "${n:-0}" -gt 0 ]; then pending=$((pending + n)); parts+=("$n de Flatpak"); fi
    fi
    arch="$(uname -m)"
    available="$(curl -fsS --proto '=https' --max-time 20 "https://download.churroslinux.org/churros/${arch}/updates.json" 2>/dev/null \
        | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version",""))' 2>/dev/null || true)"
    installed="$(cat "${CHURROS_VERSION_FILE:-/etc/churros-version}" 2>/dev/null || true)"
    # Solo una versión más nueva: una copia antigua del manifiesto no se anuncia.
    newest="$(printf '%s\n%s\n' "$available" "$installed" | sort -V | tail -n 1)"
    if [ -n "$available" ] && [ "$available" != "$installed" ] && [ "$newest" = "$available" ]; then
        pending=$((pending + 1)); parts+=("utilidades de ChurrOS $available")
    fi
    if [ "$pending" -gt 0 ]; then
        summary="$(IFS=,; echo "${parts[*]}")"
        summary="${summary//,/, }"
        notify-send -a ChurrOS -i system-software-update "Hay actualizaciones" \
            "$summary. Instálalas desde Ajustes > Actualizaciones." 2>/dev/null || true
    fi
    exit 0
fi

# Servidor (timer de sistema, como root): actualización desatendida, a
# propósito (docs/server.md).
# Todo lo que se imprime va a la salida del servicio, que guarda journald
# (`journalctl -u churros-update.service`), y a una copia en /var/log: el log no
# puede estar en /tmp (enlace simbólico de otro usuario). En un servidor no hay
# sesión gráfica, así que no se intenta ninguna notificación de escritorio (#331).
LOG="${CHURROS_UPDATE_LOG:-/var/log/churros-update.log}"

run_update() {
    local pac_rc flat_rc churros_rc
    echo "=== Actualización automática: $(date '+%F %T %Z') ==="
    churros-pkexec /usr/bin/pacman -Syu --noconfirm
    pac_rc=$?
    if command -v flatpak >/dev/null 2>&1; then
        churros-pkexec /usr/bin/flatpak update -y
        flat_rc=$?
    else
        flat_rc=0
    fi
    churros-pkexec /usr/bin/churros-update-utils
    churros_rc=$?
    local codes="pacman=$pac_rc flatpak=$flat_rc utilidades=$churros_rc"
    if [ "$pac_rc" -eq 0 ] && [ "$flat_rc" -eq 0 ] && [ "$churros_rc" -eq 0 ]; then
        echo "Resultado: correcto ($codes)"
        return 0
    fi
    echo "Resultado: FALLO ($codes); el detalle está arriba"
    return 1
}

# El código de salida es el de la actualización, no el de tee: un fallo deja
# churros-update.service en «failed» y aparece en `systemctl --failed`.
run_update 2>&1 | tee -a "$LOG"
exit "${PIPESTATUS[0]}"
