#!/usr/bin/env bash
#
# churros-pkexec — ejecuta un comando como root vía pkexec.
#
# Uso:
#   churros-pkexec /ruta/absoluta/al/programa [args...]
#
# Lo que se autoriza y cómo lo decide la regla polkit
# /etc/polkit-1/rules.d/50-churros-store.rules: el programa por ruta absoluta
# y el argv exacto. Pasa siempre la ruta absoluta; un nombre desnudo depende
# del $PATH de quien llama.
#
# Se hace `exec pkexec`, no `pkexec` como hijo: pkexec toma como sujeto de
# polkit al proceso padre, y polkit recuerda las autorizaciones
# `auth_admin_keep` por sujeto. Con exec, el padre es la app que llama y la
# contraseña sirve para los siguientes pasos durante unos minutos (actualizar
# pacman, flatpak y las utilidades pide una sola vez). Si pkexec fuera hijo de
# este script, cada llamada sería un sujeto nuevo y pediría la contraseña cada
# vez.
#
# El código de salida es el de pkexec: el del propio comando si se ejecutó,
# 126 si se cerró el diálogo y 127 si no se autorizó o no hay agente de
# polkit. No se reintenta con `sudo -n`: en el sistema instalado sudo pide
# contraseña y no habría servido; sudo solo se usa si pkexec no existe.

set -u

if [ "$#" -lt 1 ]; then
    echo "Uso: churros-pkexec <comando> [args...]" >&2
    exit 1
fi

if [ "$(id -u)" -eq 0 ]; then
    exec "$@"
fi

if command -v pkexec >/dev/null 2>&1; then
    exec pkexec "$@"
fi

if command -v sudo >/dev/null 2>&1; then
    exec sudo -n "$@"
fi

echo "churros-pkexec: no se pudo ejecutar con privilegios (no hay pkexec ni sudo)" >&2
exit 1
