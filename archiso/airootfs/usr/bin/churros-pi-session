#!/usr/bin/env bash
# Wrapper to launch labWC with clean Wayland environment
# and pi-specific waybar config.

export XDG_CURRENT_DESKTOP=ChurrOS
export XDG_SESSION_DESKTOP=ChurrOS
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland
export GDK_BACKEND=wayland,x11
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

# Waybar lo arranca /etc/xdg/labwc/autostart después de que labwc cree el
# socket Wayland; aquí no existe todavía y waybar moriría o se colgaría.

exec /usr/bin/labwc "$@"