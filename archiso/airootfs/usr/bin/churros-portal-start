#!/usr/bin/env bash
#
# churros-portal-start — Arranca xdg-desktop-portal + xdg-desktop-portal-gtk
# y configura thunar como file manager predeterminado.
#
# Idempotente: si ya estan corriendo, no los duplica.
#

log() { printf '[churros-portal] %s\n' "$*" >&2; }

# Actualizar entorno de activación systemd y D-Bus para que el portal y todas las
# aplicaciones tengan acceso a WAYLAND_DISPLAY, DBUS_SESSION_BUS_ADDRESS, etc.
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user import-environment \
        WAYLAND_DISPLAY \
        DBUS_SESSION_BUS_ADDRESS \
        XDG_SESSION_TYPE \
        XDG_CURRENT_DESKTOP \
        XDG_SESSION_DESKTOP \
        DISPLAY 2>/dev/null || true
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd \
        WAYLAND_DISPLAY \
        DBUS_SESSION_BUS_ADDRESS \
        XDG_SESSION_TYPE \
        XDG_CURRENT_DESKTOP \
        XDG_SESSION_DESKTOP \
        DISPLAY 2>/dev/null || true
fi

# Configurar thunar como file manager predeterminado
if command -v thunar >/dev/null 2>&1; then
    if command -v xdg-mime >/dev/null 2>&1; then
        xdg-mime default thunar.desktop inode/directory >/dev/null 2>&1 || true
    fi
fi

# Crear config de xdg-desktop-portal en ~/.config si no existe
PORTAL_CONF_DIR="$HOME/.config/xdg-desktop-portal"
mkdir -p "$PORTAL_CONF_DIR"

cat > "$PORTAL_CONF_DIR/portals.conf" << 'EOF'
[preferred]
default=gtk
org.freedesktop.impl.portal.FileChooser=gtk
org.freedesktop.impl.portal.Secret=gtk
org.freedesktop.impl.portal.AppChooser=gtk
org.freedesktop.impl.portal.Notification=gtk
org.freedesktop.impl.portal.Settings=gtk
org.freedesktop.impl.portal.Inhibit=gtk
EOF

chown -R "${USER:-churros}:${USER:-churros}" "$PORTAL_CONF_DIR" 2>/dev/null || true

# Iniciar servicios de portal via systemd
if command -v systemctl >/dev/null 2>&1 && systemctl --user start xdg-desktop-portal-gtk.service xdg-desktop-portal.service 2>/dev/null; then
    exit 0
fi

# Fallback manual solo si systemd no esta disponible
if ! pgrep -x xdg-desktop-portal-gtk >/dev/null 2>&1; then
    for bin in /usr/lib/xdg-desktop-portal-gtk /usr/libexec/xdg-desktop-portal-gtk; do
        if [ -x "$bin" ]; then
            log "iniciando $bin"
            setsid "$bin" >/dev/null 2>&1 &
            sleep 0.2
            break
        fi
    done
fi

if ! pgrep -x xdg-desktop-portal >/dev/null 2>&1; then
    for bin in /usr/lib/xdg-desktop-portal /usr/libexec/xdg-desktop-portal; do
        if [ -x "$bin" ]; then
            log "iniciando $bin"
            setsid "$bin" >/dev/null 2>&1 &
            break
        fi
    done
fi

exit 0
