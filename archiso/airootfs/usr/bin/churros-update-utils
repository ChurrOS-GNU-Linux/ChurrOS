#!/usr/bin/env bash
#
# churros-update-utils — comprueba y actualiza las utilidades de ChurrOS
# desde el servidor de releases. Se ejecuta como root vía churros-pkexec
# (regla polkit 50-churros-store.rules: contraseña de administrador).
#
# Uso:
#   churros-update-utils
#
# No acepta argumentos: el origen está fijado en este script. Anteriormente
# la GUI pasaba la URL leída de ~/.config/churros/settings.json
# (updates.churros_url), un fichero escribible por el usuario, de modo que
# cualquiera podía hacer que root descargara y extrajera sobre / un tarball
# arbitrario. El sha256 del manifiesto no subsanaba eso: venía del mismo
# origen no autenticado.
#
# Controles aplicados:
#   - origen fijo (https), sin overrides;
#   - el manifiesto se descarga primero y su firma minisign se verifica antes
#     de leerlo; sin clave, firma o verificador la actualización se rechaza;
#   - versión y nombre de fichero validados con expresiones regulares;
#   - el sha256 anunciado en el manifiesto debe coincidir con el descargado;
#   - el tarball solo puede traer ficheros regulares y directorios, sin rutas
#     absolutas ni "..", y solo en las rutas de ALLOWED_PREFIXES y
#     ALLOWED_FILES;
#   - se extrae en un stage y se instala fichero a fichero (modo 0755 o 0644,
#     rename atómico). Nunca se copian atributos de directorio sobre /, /usr
#     o /etc (#130).
#
# Las funciones se pueden cargar con `source` para probarlas
# (scripts/test-privileged-helpers.py); main solo corre al ejecutar el script.

set -euo pipefail
export LC_ALL=C
umask 022

case "$(uname -m)" in
    x86_64) UPDATE_ARCH=x86_64 ;;
    aarch64|arm64) UPDATE_ARCH=aarch64 ;;
    i386|i486|i586|i686) UPDATE_ARCH=i686 ;;
    *) printf 'ERROR: arquitectura no soportada para actualizaciones: %s\n' "$(uname -m)" >&2; exit 1 ;;
esac
BASE="https://download.churroslinux.org/churros/${UPDATE_ARCH}/"
PUBKEY=/usr/share/churros/churros-release.pubkey
PACMAN=/usr/bin/pacman
PACMAN_KEY=/usr/bin/pacman-key
PACMAN_CONF=/etc/pacman.conf
CACHYOS_MIRRORLIST=/etc/pacman.d/cachyos-mirrorlist
CACHYOS_KEYRING=/usr/share/pacman/keyrings/cachyos.gpg
# Existe en el Live de archiso: ahí no hay nada que reparar (no persiste).
LIVE_MARKER=/run/archiso
LOCAL_DB=/var/lib/pacman/local
PACMAN_LOCK=/var/lib/pacman/db.lck
GNUPG_DIR=/etc/pacman.d/gnupg
SYSTEMD_DIR=/etc/systemd/system
VOLATILE_JOURNAL=/etc/systemd/journald.conf.d/volatile-storage.conf
# Unidades del Live que Calamares intentaba enmascarar sin conseguirlo.
LIVE_UNITS=(pacman-init.service etc-pacman.d-gnupg.mount choose-mirror.service livecd-talk.service)
# Espacio libre mínimo en / para reparar (firmware, mesa, python...).
REPAIR_MIN_FREE_MB=1500

VERSION_FILE=/etc/churros-version
EDITION_FILE=/etc/churros-edition

# Rutas que el bundle puede tocar, relativas a /. Un prefijo que acaba en "/"
# admite cualquier fichero por debajo; uno que acaba en "churros-" solo
# admite ficheros directos de ese directorio cuyo nombre empiece así.
# Cualquier otra ruta (passwd, sudoers, units de systemd, bibliotecas...) se
# rechaza.
ALLOWED_PREFIXES=(
    usr/bin/churros-
    usr/local/bin/churros-
    usr/share/churros/
)

# Ficheros sueltos, por ruta exacta.
ALLOWED_FILES=(
    etc/churros-version
    etc/churros-edition
    # Hook de rollback que lleva el bundle (build-churros-release.sh). Solo
    # llama a /usr/local/bin/churros-snapshot, que el bundle ya puede
    # actualizar.
    etc/pacman.d/hooks/50-churros-snapshot.hook
)

TMP_MANIFEST=""
DL=""
STAGE=""
INSTALL_TMP=""

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

cleanup() {
    if [ -n "$TMP_MANIFEST" ]; then
        rm -f -- "$TMP_MANIFEST" "$TMP_MANIFEST.minisig"
    fi
    if [ -n "$DL" ]; then
        rm -f -- "$DL"
    fi
    if [ -n "$STAGE" ]; then
        rm -rf -- "$STAGE"
    fi
    if [ -n "$INSTALL_TMP" ]; then
        rm -f -- "$INSTALL_TMP"
    fi
    return 0
}

# download DESTINO URL — solo https y TLS 1.2 o superior.
download() {
    curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 10 -o "$1" "$2"
}

# --------------------------------------------------------------- edición

detect_edition() {
    local edition="" var_id
    if [ -f "$EDITION_FILE" ]; then
        edition="$(tr -d '[:space:]' < "$EDITION_FILE" | tr '[:upper:]' '[:lower:]')"
    elif [ -f /etc/os-release ]; then
        var_id="$(grep -E '^VARIANT_ID=' /etc/os-release | cut -d= -f2 | tr -d '"' | tr -d '[:space:]' || true)"
        edition="$var_id"
    fi
    edition="${edition:-niri}"
    # Solo se usa como clave de lookup en el manifiesto: se restringe igual.
    case "$edition" in
        *[!a-z0-9_-]*) die "edición inválida: $edition" ;;
    esac
    printf '%s\n' "$edition"
}

# ------------------------------------------------------------ manifiesto

# Firma minisign del manifiesto ya descargado. Antes se comprobaba antes de
# descargarlo, contra un fichero vacío, así que con la clave publicada no
# habría validado nunca (#139).
am_root() {
    [ "$(id -u)" -eq 0 ]
}

# La 1.4 no traía minisign y se actualiza a la 1.5 con un bundle (que no
# instala paquetes): sin esto, su siguiente actualización moriría aquí. Como
# root se instala del repositorio de Arch (paquete firmado, sin -y: Ajustes
# ya ha hecho pacman -Syu justo antes). Sin root, se aborta como siempre.
ensure_minisign() {
    command -v minisign >/dev/null 2>&1 && return 0
    if am_root && [ -x "$PACMAN" ]; then
        echo "Instalando minisign para verificar la firma de las actualizaciones..."
        "$PACMAN" -S --needed --noconfirm minisign >&2 \
            || die "no se pudo instalar minisign: instálalo con 'sudo pacman -S minisign' y repite"
        command -v minisign >/dev/null 2>&1 && return 0
    fi
    die "falta minisign para verificar la firma del manifiesto (sudo pacman -S minisign)"
}

verify_manifest() {
    local manifest="$1"
    [ -r "$PUBKEY" ] || die "falta la clave pública de releases: $PUBKEY"
    ensure_minisign
    download "$manifest.minisig" "${BASE}updates.json.minisig" \
        || die "no se pudo obtener la firma minisign del manifiesto"
    minisign -V -p "$PUBKEY" -m "$manifest" -x "$manifest.minisig" >/dev/null 2>&1 \
        || die "firma minisign inválida: no se acepta updates.json"
    echo "Firma del manifiesto verificada."
}

# fetch_manifest DESTINO — descarga updates.json y verifica su firma.
fetch_manifest() {
    download "$1" "${BASE}updates.json" || die "no se pudo obtener updates.json"
    verify_manifest "$1"
}

# parse_manifest MANIFIESTO EDICION — imprime "versión|fichero|sha256".
# La edición se pasa por entorno, no interpolada en el source de python.
parse_manifest() {
    CHURROS_EDITION="$2" CHURROS_ARCH="${3:-$UPDATE_ARCH}" python3 -c '
import json, os, re, sys

edition = os.environ["CHURROS_EDITION"]
expected_arch = os.environ["CHURROS_ARCH"]
data = json.load(sys.stdin)

actual_arch = data.get("arch")
if actual_arch != expected_arch:
    sys.exit(f"arquitectura inválida en el manifiesto: {actual_arch!r} != {expected_arch!r}")

version = data.get("version", "")
if not isinstance(version, str) or not re.fullmatch(r"[0-9]+(\.[0-9]+)*", version):
    sys.exit("version inválida en el manifiesto")

entry = None
editions = data.get("editions")
if isinstance(editions, dict):
    entry = editions.get(edition)
    if entry is None:
        entry = editions.get("niri")
if not isinstance(entry, dict):
    entry = {"file": data.get("file", ""), "sha256": data.get("sha256", "")}

file = entry.get("file", "")
sha = entry.get("sha256", "")
if not isinstance(file, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*\.tar\.zst", file):
    sys.exit("nombre de fichero inválido en el manifiesto")
if not isinstance(sha, str) or not re.fullmatch(r"[0-9a-f]{64}", sha):
    sys.exit("sha256 inválido en el manifiesto")

print(f"{version}|{file}|{sha}")
' < "$1"
}

# ------------------------------------------------------- rutas del bundle

# member_allowed RUTA — ¿puede el bundle tocar esta ruta, relativa a /?
member_allowed() {
    local rel="$1" entry rest
    # Nada absoluto ni componentes vacíos, "." o "..".
    case "/$rel/" in
        *//*|*/./*|*/../*) return 1 ;;
    esac
    for entry in "${ALLOWED_FILES[@]}"; do
        if [ "$rel" = "$entry" ]; then
            return 0
        fi
    done
    for entry in "${ALLOWED_PREFIXES[@]}"; do
        case "$rel" in
            "$entry"?*) ;;
            *) continue ;;
        esac
        case "$entry" in
            */) return 0 ;;
        esac
        # Prefijo de nombre: un fichero directo, sin subdirectorios.
        rest="${rel#"$entry"}"
        case "$rest" in
            */*) return 1 ;;
        esac
        return 0
    done
    return 1
}

# validate_tarball TARBALL — tipos y rutas de los miembros, antes de extraer.
validate_tarball() {
    local tarball="$1" listing types member type
    listing="$(tar --zstd -tf "$tarball")" || die "el paquete no es un tarball válido"
    types="$(tar --zstd -tvf "$tarball" | cut -c1)" || die "el paquete no es un tarball válido"

    # Solo ficheros regulares y directorios. Un enlace a /etc/shadow
    # convertiría la instalación en escritura arbitraria, y un dispositivo o
    # una FIFO no pintan nada en un bundle de utilidades.
    while IFS= read -r type; do
        [ -n "$type" ] || continue
        case "$type" in
            -|d) ;;
            *) die "el paquete contiene entradas que no son ficheros ni directorios (tipo '$type')" ;;
        esac
    done <<< "$types"

    while IFS= read -r member; do
        [ -n "$member" ] || continue
        case "$member" in
            /*) die "el paquete contiene una ruta absoluta: $member" ;;
        esac
        member="${member#./}"
        case "$member" in
            ''|.|./) continue ;;
        esac
        case "/${member%/}/" in
            *//*|*/./*|*/../*) die "el paquete contiene '..', '.' o '//': $member" ;;
        esac
        # Los directorios no se validan contra la lista: se crean al instalar,
        # con 0755, solo si contienen algún fichero permitido.
        case "$member" in
            */) continue ;;
        esac
        member_allowed "$member" || die "el paquete toca una ruta no permitida: $member"
    done <<< "$listing"
}

# validate_stage_arch STAGE — rechaza ejecutables ELF de otra arquitectura (#306).
validate_stage_arch() {
    local stage="$1"
    CHURROS_STAGE="$stage" CHURROS_ARCH="$UPDATE_ARCH" python3 - <<'PY'
import os
import struct
import sys

stage = os.environ["CHURROS_STAGE"]
arch = os.environ["CHURROS_ARCH"]
expected = {
    "x86_64": (0x3E, 64),   # EM_X86_64, ELFCLASS64
    "aarch64": (0xB7, 64),  # EM_AARCH64, ELFCLASS64
    "i686": (0x03, 32),     # EM_386, ELFCLASS32
}.get(arch)
if expected is None:
    sys.exit(f"arquitectura de actualización no soportada: {arch}")

for root, _dirs, files in os.walk(stage):
    for name in files:
        path = os.path.join(root, name)
        try:
            with open(path, "rb") as fh:
                hdr = fh.read(20)
        except OSError:
            continue
        if len(hdr) < 20 or hdr[:4] != b"\x7fELF":
            continue
        ei_class = hdr[4]
        ei_data = hdr[5]
        if ei_class not in (1, 2) or ei_data not in (1, 2):
            sys.exit(f"ELF inválido en el paquete: {os.path.relpath(path, stage)}")
        endian = "<" if ei_data == 1 else ">"
        e_machine = struct.unpack_from(endian + "H", hdr, 18)[0]
        want_machine, want_bits = expected
        got_bits = 32 if ei_class == 1 else 64
        if e_machine != want_machine or got_bits != want_bits:
            sys.exit(
                f"ELF de arquitectura incompatible en el paquete: {os.path.relpath(path, stage)} "
                f"(machine={e_machine}, class={got_bits}; esperado {arch})"
            )
PY
}

# ---------------------------------------------------------------- instalar

# install_stage STAGE RAIZ — instala en RAIZ los ficheros del stage.
#
# Solo ficheros regulares, cada uno con modo 0755 (si el bundle lo trae
# ejecutable) o 0644, copiados a un temporal en su directorio y renombrados
# encima del destino: el cambio es atómico y un binario en uso conserva su
# inodo. Los directorios que faltan se crean con 0755 y los existentes no se
# tocan. Antes se hacía `cp -a "$STAGE"/. /`, que copiaba los atributos del
# stage (0700 de mktemp -d) sobre / y dejaba el sistema inutilizable (#130).
install_stage() {
    local stage="$1" root="${2%/}" src rel dest dir perms mode
    local -a files=()

    # Primero se valida todo, para no dejar una instalación a medias.
    while IFS= read -r -d '' src; do
        rel="${src#"$stage"/}"
        if [ -L "$src" ] || [ ! -f "$src" ]; then
            die "el paquete contiene algo que no es un fichero regular: $rel"
        fi
        member_allowed "$rel" || die "el paquete toca una ruta no permitida: $rel"
        files+=("$rel")
    done < <(find "$stage" -mindepth 1 ! -type d -print0)

    for rel in "${files[@]}"; do
        src="$stage/$rel"
        dest="$root/$rel"
        dir="${dest%/*}"
        perms="$(stat -c %a -- "$src")"
        if (( 8#$perms & 8#111 )); then
            mode=0755
        else
            mode=0644
        fi
        mkdir -p -- "$dir"
        INSTALL_TMP="$(mktemp -- "$dir/.churros-update.XXXXXX")"
        cat -- "$src" > "$INSTALL_TMP"
        chmod "$mode" -- "$INSTALL_TMP"
        mv -fT -- "$INSTALL_TMP" "$dest"
        INSTALL_TMP=""
    done
}

# ------------------------------------- reparación de la 1.4 y la 1.5 (CachyOS)
#
# Las ISO 1.4 y 1.5 se construyeron con [cachyos] delante de [core] (#378):
# instalaron de CachyOS pacman, mesa, python, xz, zstd, linux-firmware,
# archlinux-keyring... y el sistema instalado no tiene [cachyos]. Los que
# llevan epoch (archlinux-keyring 1:, mesa 3:) no se actualizan nunca y
# linux-cachyos (Niri) tampoco. La reparación, una vez y solo si hace falta:
#   1. con linux-cachyos, añade [cachyos] al final de pacman.conf y su clave;
#   2. sincroniza;
#   3. quita linux-cachyos-headers si nada lo usa (pide el pahole de CachyOS
#      y, con [cachyos] al final, bloquearía pacman -Syu);
#   4. en UNA transacción (-Su) actualiza todo y vuelve a instalar desde Arch
#      (core/pacman, extra/mesa...) cada paquete empaquetado por CachyOS que
#      Arch también tiene. Lo que solo tiene CachyOS (linux-cachyos,
#      cachyos-*) se queda. El hook 50-churros-snapshot hace un snapshot antes
#      de cada transacción.

# cachyos_built — paquetes instalados empaquetados por CachyOS (campo Packager).
cachyos_built() {
    LC_ALL=C "$PACMAN" -Qi 2>/dev/null \
        | awk -F' *: ' '/^Name /{name=$2} /^Packager /{if ($2 ~ /CachyOS/) print name}'
}

# arch_repo_packages — "repo/nombre" de core, extra y multilib (base sincronizada).
arch_repo_packages() {
    LC_ALL=C "$PACMAN" -Sl 2>/dev/null \
        | awk '$1=="core" || $1=="extra" || $1=="multilib" {print $1 "/" $2}'
}

# headers_in_use — ¿algo instalado necesita linux-cachyos-headers (DKMS)?
headers_in_use() {
    local required
    required="$(LC_ALL=C "$PACMAN" -Qi linux-cachyos-headers 2>/dev/null \
        | awk -F' *: ' '/^Required By /{print $2}')"
    [ -n "$required" ] && [ "$required" != "None" ] && return 0
    # Sin tuberías a grep -q: con pipefail, su salida temprana (SIGPIPE en
    # quien escribe) haría creer que no hay DKMS y se quitarían headers en uso.
    local installed
    installed="$(LC_ALL=C "$PACMAN" -Qq 2>/dev/null || true)"
    case $'\n'"$installed"$'\n' in
        *-dkms$'\n'*) return 0 ;;
    esac
    return 1
}

# repair_targets — "repo/nombre" que hay que volver a instalar desde Arch.
repair_targets() {
    local keep_pahole="$1" name entry
    local -A arch=()
    while IFS= read -r entry; do
        [ -n "$entry" ] && arch["${entry#*/}"]="$entry"
    done < <(arch_repo_packages)
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        # Con los headers de CachyOS en uso, su pahole (>= el de Arch) se queda.
        if [ "$name" = pahole ] && [ "$keep_pahole" = yes ]; then
            continue
        fi
        if [ -n "${arch[$name]:-}" ]; then
            printf '%s\n' "${arch[$name]}"
        fi
    done < <(cachyos_built)
}

# ensure_cachyos_repo — con linux-cachyos, [cachyos] al final y su clave cargada.
ensure_cachyos_repo() {
    "$PACMAN" -Q linux-cachyos >/dev/null 2>&1 || return 0
    if grep -q '^\[cachyos\]' "$PACMAN_CONF"; then
        return 0
    fi
    [ -f "$CACHYOS_MIRRORLIST" ] \
        || die "linux-cachyos sin $CACHYOS_MIRRORLIST: no se puede añadir [cachyos]"
    [ -f "$CACHYOS_KEYRING" ] \
        || die "linux-cachyos sin la clave de CachyOS ($CACHYOS_KEYRING)"
    echo "Añadiendo [cachyos] al final de $PACMAN_CONF (solo para el kernel)..."
    "$PACMAN_KEY" --populate cachyos >/dev/null 2>&1 \
        || die "no se pudo cargar la clave de CachyOS (pacman-key --populate cachyos)"
    printf '\n# Solo lo que Arch no tiene (linux-cachyos, cachyos-*): va al final.\n[cachyos]\nInclude = %s\n' \
        "$CACHYOS_MIRRORLIST" >> "$PACMAN_CONF"
}

# forget_cachyos_db_key — el pacman de CachyOS (con parches) apunta en la base
# de datos local de qué repositorio salió cada paquete (%INSTALLED_DB%). El de
# Arch no conoce ese campo: tras volver a él, cada orden avisaba «unknown key
# '%INSTALLED_DB%'» por cada paquete que hubiese instalado el de CachyOS. Solo
# si el pacman instalado se queja, se quita ese bloque de cada desc (escritura
# atómica; pacman no usa ese dato).
forget_cachyos_db_key() {
    local warnings
    # -Qi lee cada desc (con -Qq, que solo lista nombres, pacman no avisa).
    # Se guarda la salida antes de buscar: con pipefail, `pacman | grep -q`
    # falla en cuanto grep sale (SIGPIPE) y la limpieza no se hacía nunca.
    warnings="$(LC_ALL=C "$PACMAN" -Qi 2>&1 >/dev/null || true)"
    case "$warnings" in
        *"unknown key '%INSTALLED_DB%'"*) ;;
        *) return 0 ;;
    esac
    echo "Limpiando un campo del pacman de CachyOS en la base de datos local..."
    CHURROS_LOCAL_DB="$LOCAL_DB" python3 - <<'PY' || die "no se pudo limpiar la base de datos local de pacman"
import os
import re
import tempfile

root = os.environ["CHURROS_LOCAL_DB"]
block = re.compile(r"%INSTALLED_DB%\n[^\n]*\n(?:\n|\Z)")
for entry in sorted(os.listdir(root)):
    path = os.path.join(root, entry, "desc")
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read()
    except OSError:
        continue
    if "%INSTALLED_DB%" not in text:
        continue
    mode = os.stat(path).st_mode & 0o7777
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".desc.")
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(block.sub("", text))
    os.chmod(tmp, mode)
    os.replace(tmp, path)
PY
}

# live_units_present — ¿se coló el llavero en memoria del Live en el sistema?
live_units_present() {
    [ -f "$SYSTEMD_DIR/etc-pacman.d-gnupg.mount" ] || [ -f "$SYSTEMD_DIR/pacman-init.service" ]
}

# fix_live_keyring — 1.4/1.5 instaladas: Calamares no pudo enmascarar
# pacman-init (el Live lo trae como fichero en /etc/systemd/system) y cada
# arranque montaba un tmpfs vacío en /etc/pacman.d/gnupg: llavero regenerado,
# pacman -Sy fallando hasta que pacman-init terminaba y claves añadidas a mano
# perdidas. Se deja el llavero del disco completo y después se quitan las
# unidades; si algo falla antes, no se toca nada.
fix_live_keyring() {
    local unit escaped
    live_units_present || return 0
    echo "Quitando el llavero de pacman en memoria que se coló del Live..."
    systemctl stop pacman-init.service >/dev/null 2>&1 || true
    # Arch activa sockets de gpg dentro del llavero (gpg-agent@, keyboxd@,
    # dirmngr@etc-pacman.d-gnupg.socket): los tiene abiertos systemd y el
    # tmpfs no se puede desmontar ("target is busy") hasta pararlos.
    escaped="$(systemd-escape --path "$GNUPG_DIR")"
    systemctl stop "*@$escaped.socket" "*@$escaped.service" >/dev/null 2>&1 || true
    gpgconf --homedir "$GNUPG_DIR" --kill all >/dev/null 2>&1 || true
    if mountpoint -q "$GNUPG_DIR"; then
        umount "$GNUPG_DIR" || die "no se pudo desmontar $GNUPG_DIR: no se ha cambiado nada"
    fi
    # El del disco lo creó Calamares; --init no borra claves y --populate
    # añade todas las de /usr/share/pacman/keyrings (Arch y, si está, CachyOS).
    "$PACMAN_KEY" --init >/dev/null 2>&1 || die "no se pudo inicializar el llavero de pacman en el disco"
    "$PACMAN_KEY" --populate >/dev/null 2>&1 || die "no se pudo cargar el llavero de pacman en el disco"
    for unit in "${LIVE_UNITS[@]}"; do
        rm -f -- "$SYSTEMD_DIR/$unit" "$SYSTEMD_DIR/multi-user.target.wants/$unit"
    done
    systemctl daemon-reload >/dev/null 2>&1 || true
    # De vuelta los sockets de gpg, ahora sobre el llavero del disco.
    systemctl start sockets.target >/dev/null 2>&1 || true
}

# persist_journal — el Live guarda el journal solo en memoria
# (journald.conf.d/volatile-storage.conf) y se coló en 1.4/1.5: el registro
# del sistema se perdía en cada reinicio y no había forma de saber qué falló.
persist_journal() {
    [ -e "$VOLATILE_JOURNAL" ] || return 0
    echo "Guardando el registro del sistema en disco (se perdía en cada reinicio)..."
    rm -f -- "$VOLATILE_JOURNAL"
    systemctl restart systemd-journald.service >/dev/null 2>&1 || true
    journalctl --flush >/dev/null 2>&1 || true
}

free_mb() {
    df -Pm / | awk 'NR==2 {print $4}'
}

# repair_needed — ¿hay paquetes de CachyOS que Arch también tiene? Mira la
# base de datos ya sincronizada (Ajustes acaba de hacer pacman -Syu).
repair_needed() {
    live_units_present && return 0
    [ -e "$VOLATILE_JOURNAL" ] && return 0
    [ -n "$(repair_targets no)" ] && return 0
    "$PACMAN" -Q linux-cachyos >/dev/null 2>&1 && ! grep -q '^\[cachyos\]' "$PACMAN_CONF"
}

repair_cachyos_packages() {
    local keep_pahole=no free
    local -a targets=()

    am_root || return 0
    [ -e "$LIVE_MARKER" ] && return 0
    repair_needed || return 0

    echo "Reparando paquetes del sistema que la ISO instaló desde CachyOS..."
    free="$(free_mb)"
    [ "${free:-0}" -ge "$REPAIR_MIN_FREE_MB" ] \
        || die "hacen falta ${REPAIR_MIN_FREE_MB} MB libres en / para reparar (hay ${free:-0} MB): libera espacio y repite"

    # Primero el llavero: lo necesita el -Sy de abajo.
    fix_live_keyring
    persist_journal
    ensure_cachyos_repo
    "$PACMAN" -Sy --noconfirm || die "no se pudieron sincronizar los repositorios"

    if "$PACMAN" -Q linux-cachyos-headers >/dev/null 2>&1; then
        if headers_in_use; then
            echo "AVISO: linux-cachyos-headers está en uso (DKMS): se conserva, con el pahole de CachyOS."
            keep_pahole=yes
        else
            echo "Quitando linux-cachyos-headers (nada lo usa; bloquearía las actualizaciones)..."
            "$PACMAN" -Rs --noconfirm linux-cachyos-headers \
                || die "no se pudo quitar linux-cachyos-headers"
        fi
    fi

    mapfile -t targets < <(repair_targets "$keep_pahole")
    if [ "${#targets[@]}" -gt 0 ]; then
        echo "Volviendo a los paquetes de Arch: ${targets[*]}"
    fi
    # Una sola transacción: todo el sistema al día y, a la vez, cada paquete
    # de CachyOS sustituido por el de Arch (aunque baje de versión).
    "$PACMAN" -Su --noconfirm "${targets[@]}" \
        || die "la reparación no se completó; el sistema no se ha tocado o hay un snapshot previo (Ajustes > Actualizaciones > Rollback)"
    forget_cachyos_db_key
    # Al disco antes de decir «listo»: btrfs escribe cada 30 s y un corte de
    # luz justo después devolvía las unidades del Live (visto en la VM).
    sync
    echo "Sistema reparado. Reinicia el equipo para usar el kernel, mesa y el firmware nuevos."
}

# --------------------------------------------- candado huérfano de pacman
#
# Un apagón o un reinicio a mitad de una transacción deja db.lck y pacman no lo
# borra nunca: cada actualización siguiente falla con «unable to lock
# database». Solo se quita si es seguro que está huérfano: se creó antes del
# arranque actual (ningún proceso sobrevive a un reinicio) y no hay ningún
# pacman en marcha.

boot_time() { awk '/^btime /{print $2}' /proc/stat; }
pacman_running() { pgrep -x pacman >/dev/null 2>&1; }

clear_stale_pacman_lock() {
    local created boot
    [ -e "$PACMAN_LOCK" ] || return 0
    am_root || return 0
    pacman_running && return 0
    created="$(stat -c %Y -- "$PACMAN_LOCK" 2>/dev/null)" || return 0
    boot="$(boot_time)"
    [ -n "$boot" ] && [ "$created" -lt "$boot" ] || return 0
    echo "Quitando el candado de pacman de una actualización que se cortó (apagón o reinicio)..."
    rm -f -- "$PACMAN_LOCK"
}

# -------------------------------------------------------------------- main

main() {
    local edition parsed version file sha256 installed got

    if [ "$#" -ne 0 ]; then
        die "este comando no acepta argumentos (el origen está fijado en $BASE)"
    fi
    trap cleanup EXIT

    # Antes que el bundle: si el sistema no está sano, las utilidades nuevas
    # (compiladas contra el Arch de hoy) podrían no arrancar.
    clear_stale_pacman_lock
    repair_cachyos_packages

    edition="$(detect_edition)"
    echo "Comprobando utilidades de ChurrOS ($BASE) [edición: $edition]..."

    TMP_MANIFEST="$(mktemp)"
    fetch_manifest "$TMP_MANIFEST"
    parsed="$(parse_manifest "$TMP_MANIFEST" "$edition")" \
        || die "updates.json mal formado o edición no encontrada"
    IFS='|' read -r version file sha256 <<< "$parsed"

    installed="$(cat "$VERSION_FILE" 2>/dev/null || echo "")"
    if [ -n "$installed" ] && [ "$version" = "$installed" ]; then
        echo "Utilidades de ChurrOS al día (v$installed)."
        return 0
    fi

    echo "Actualizando utilidades de ChurrOS: v${installed:-?} -> v$version"
    echo "Descargando $file..."
    DL="$(mktemp)"
    download "$DL" "${BASE}${file}" || die "descarga fallida"

    echo "Verificando sha256..."
    got="$(sha256sum "$DL" | awk '{print $1}')"
    [ "$got" = "$sha256" ] || die "sha256 no coincide ($got != $sha256)"

    echo "Validando contenido del paquete..."
    validate_tarball "$DL"

    STAGE="$(mktemp -d /run/churros-update.XXXXXX)"
    # Root conserva los permisos del archivo (sin --no-same-permissions) para
    # saber qué es ejecutable; install_stage los deja en 0755 o 0644.
    tar --zstd -xf "$DL" -C "$STAGE" --no-same-owner \
        || die "fallo al extraer el paquete"

    echo "Validando arquitectura de los ejecutables..."
    validate_stage_arch "$STAGE"

    echo "Instalando..."
    install_stage "$STAGE" /

    # Solo tras instalar se actualiza la versión instalada.
    if ! printf '%s\n' "$version" | cmp -s - "$VERSION_FILE"; then
        printf '%s\n' "$version" > "$VERSION_FILE"
    fi

    sync
    echo "Utilidades de ChurrOS actualizadas a v$version."
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
