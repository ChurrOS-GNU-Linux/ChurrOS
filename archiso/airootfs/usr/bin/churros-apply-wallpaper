#!/usr/bin/env bash
#
# churros-apply-wallpaper
#   Aplica un wallpaper al compositor activo (Niri / Hyprland / Sway).
#
#   Backends soportados en orden:
#     1. Noctalia, si está en marcha. Reintenta el IPC y, si falla, sale
#        con error: swaybg no puede arrancar encima del shell.
#     2. swaybg (estatico, simple; KDE/XFCE y sesiones sin Noctalia)
#     3. awww (animations, GIF, multi-output)
#
#   Detecta automaticamente WAYLAND_DISPLAY y XDG_RUNTIME_DIR si no
#   estan en el entorno (caso live ISO sin session explicita).
#
#   Uso:
#     churros-apply-wallpaper                  # lee settings.json
#     churros-apply-wallpaper /path/img.jpg    # aplica esa imagen
#

set -u

SETTINGS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/churros/settings.json"

LOG_PREFIX="[churros-apply-wallpaper]"

_detect_session_env() {

    local uid
    uid=$(id -u)

    if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
        export XDG_RUNTIME_DIR="/run/user/${uid}"
    fi

    # 1. Si WAYLAND_DISPLAY ya está definido y el socket existe, usarlo directamente
    if [ -n "${WAYLAND_DISPLAY:-}" ] && [ -S "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY}" ]; then
        return 0
    fi

    # 2. Intentar extraer WAYLAND_DISPLAY del compositor activo (niri / hyprland / sway)
    local comp
    for comp in niri hyprland sway; do
        local pid
        pid=$(pgrep -u "$uid" -x "$comp" 2>/dev/null | head -n 1 || true)
        if [ -n "$pid" ] && [ -r "/proc/$pid/environ" ]; then
            local comp_wd
            comp_wd=$(tr '\0' '\n' < "/proc/$pid/environ" 2>/dev/null | grep -E '^WAYLAND_DISPLAY=' | head -n 1 | cut -d= -f2- || true)
            if [ -n "$comp_wd" ] && [ -S "${XDG_RUNTIME_DIR}/${comp_wd}" ]; then
                export WAYLAND_DISPLAY="$comp_wd"
                echo "$LOG_PREFIX detecto WAYLAND_DISPLAY=$WAYLAND_DISPLAY desde $comp (PID $pid)" >&2
                return 0
            fi
        fi
    done

    # 3. Fallback: buscar el socket wayland más reciente por fecha de modificación en XDG_RUNTIME_DIR
    if [ -d "$XDG_RUNTIME_DIR" ]; then
        local newest_sock
        newest_sock=$(ls -t "${XDG_RUNTIME_DIR}"/wayland-* 2>/dev/null | grep -v '\.lock$' | head -n 1 || true)
        if [ -n "$newest_sock" ] && [ -S "$newest_sock" ]; then
            export WAYLAND_DISPLAY="${newest_sock##*/}"
            echo "$LOG_PREFIX detecto WAYLAND_DISPLAY=$WAYLAND_DISPLAY (socket mas reciente en $XDG_RUNTIME_DIR)" >&2
            return 0
        fi
    fi

    echo "$LOG_PREFIX NO se detecto socket Wayland activo" >&2
    return 1
}

_awww_running() {
    pgrep -x awww-daemon >/dev/null 2>&1
}

_awww_kill() {
    pkill -TERM -x awww-daemon 2>/dev/null || true
}

_swaybg_running() {
    pgrep -x swaybg >/dev/null 2>&1
}

_swaybg_kill() {
    pkill -TERM -x swaybg 2>/dev/null || true
}

apply_awww() {

    local path="$1"

    if ! _detect_session_env; then
        return 1
    fi

    if [ -z "$WAYLAND_DISPLAY" ]; then
        echo "$LOG_PREFIX WAYLAND_DISPLAY vacio, no se puede usar awww" >&2
        return 1
    fi

    if ! _awww_running; then

        echo "$LOG_PREFIX lanzando awww-daemon (WAYLAND=$WAYLAND_DISPLAY)..." >&2

        WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
            awww-daemon </dev/null >> /tmp/awww-daemon.log 2>&1 &
        local awww_pid=$!
        disown "$awww_pid" 2>/dev/null || true

        for _ in 1 2 3 4; do
            sleep 0.15
            if _awww_running; then
                echo "$LOG_PREFIX awww-daemon listo (PID $(pgrep -x awww-daemon))" >&2
                break
            fi
        done

        if ! _awww_running; then
            echo "$LOG_PREFIX awww-daemon no arranco, ver /tmp/awww-daemon.log" >&2
            return 1
        fi
    fi

    echo "$LOG_PREFIX awww img $path (WAYLAND=$WAYLAND_DISPLAY XDG=$XDG_RUNTIME_DIR)" >&2

    local attempt
    for attempt in 1 2; do
        WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
            awww img "$path" >/tmp/awww-img.log 2>&1
        local rc=$?

        if [ "$rc" -eq 0 ]; then
            echo "$LOG_PREFIX awww OK intento $attempt: $path" >&2
            _swaybg_kill
            return 0
        fi

        echo "$LOG_PREFIX awww intento $attempt fallo rc=$rc: $(head -3 /tmp/awww-img.log 2>/dev/null)" >&2
        sleep 0.2
    done

    echo "$LOG_PREFIX awww fallo tras $attempt intentos" >&2
    return 1
}

apply_swaybg() {

    local path="$1"

    if ! _detect_session_env; then
        return 1
    fi

    # Si awww-daemon estaba activo, detenerlo para no solapar layer surfaces
    if _awww_running; then
        _awww_kill
        sleep 0.1
    fi

    echo "$LOG_PREFIX swaybg -i $path -m fill (WAYLAND=$WAYLAND_DISPLAY XDG=$XDG_RUNTIME_DIR)" >&2

    local uid
    uid=$(id -u)
    local old_pids
    old_pids=$(pgrep -u "$uid" -x swaybg 2>/dev/null || true)

    # Lanzar swaybg desacoplado en segundo plano
    WAYLAND_DISPLAY="$WAYLAND_DISPLAY" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        swaybg -i "$path" -m fill </dev/null >> /tmp/swaybg.log 2>&1 &
    local new_pid=$!
    disown "$new_pid" 2>/dev/null || true

    # Verificar que el nuevo swaybg arrancó y sigue vivo
    local started=0
    for _ in 1 2 3 4 5; do
        sleep 0.1
        if kill -0 "$new_pid" 2>/dev/null; then
            started=1
            break
        fi
    done

    if [ "$started" -eq 1 ]; then
        # Terminar las instancias viejas SOLO tras confirmar que la nueva arrancó
        if [ -n "$old_pids" ]; then
            for opid in $old_pids; do
                if [ "$opid" != "$new_pid" ] && kill -0 "$opid" 2>/dev/null; then
                    kill -TERM "$opid" 2>/dev/null || true
                fi
            done
        fi
        echo "$LOG_PREFIX swaybg OK: $path (PID $new_pid)" >&2
        return 0
    fi

    echo "$LOG_PREFIX swaybg fallo al arrancar, ver /tmp/swaybg.log" >&2
    return 1
}

# Noctalia en marcha: es el único pintor del fondo. `pgrep` falla si no corre.
noctalia_running() {
    command -v noctalia >/dev/null 2>&1 || return 1
    pgrep -u "$(id -u)" -x noctalia >/dev/null 2>&1
}

# IPC de Noctalia 5.2.1: `noctalia msg wallpaper-set <ruta>`.
# EAGAIN (`Resource temporarily unavailable`) es transitorio: Noctalia puede
# haber pintado el fondo y seguir ocupado. Cada intento se corta a los 3 s
# y entre medias se espera 1.5 s y luego 2.5 s (como mucho ~13 s, por debajo
# del tope de 18 s de Settings). Si los tres fallan, se devuelve error.
# No se arranca swaybg.
apply_noctalia() {

    local path="$1"
    local attempt rc log

    noctalia_running || return 1
    # Un swaybg de un intento anterior se queda debajo del shell.
    _swaybg_kill

    for attempt in 1 2 3; do
        echo "$LOG_PREFIX noctalia msg wallpaper-set $path (intento $attempt)" >&2
        if command -v timeout >/dev/null 2>&1; then
            timeout 3 noctalia msg wallpaper-set "$path" >/tmp/noctalia-wallpaper.log 2>&1
        else
            noctalia msg wallpaper-set "$path" >/tmp/noctalia-wallpaper.log 2>&1
        fi
        rc=$?
        if [ "$rc" -eq 0 ]; then
            echo "$LOG_PREFIX noctalia OK intento $attempt: $path" >&2
            return 0
        fi
        log="$(head -3 /tmp/noctalia-wallpaper.log 2>/dev/null || true)"
        echo "$LOG_PREFIX noctalia intento $attempt fallo: $log" >&2
        if [ "$attempt" -ge 3 ]; then
            break
        fi
        # EAGAIN y el corte por timeout se reintentan; no son un fallo final.
        if [ "$rc" -eq 124 ] || printf '%s\n' "$log" | grep -Eiq 'resource temporarily unavailable|eagain'; then
            echo "$LOG_PREFIX noctalia ocupado (EAGAIN); se reintenta" >&2
        fi
        if [ "$attempt" -eq 1 ]; then
            sleep 1.5
        else
            sleep 2.5
        fi
    done

    echo "$LOG_PREFIX noctalia no acepto el fondo tras 3 intentos; swaybg no se arranca" >&2
    return 1
}

apply_kde() {

    local path="$1"

    if ! command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
        return 1
    fi

    echo "$LOG_PREFIX aplicando fondo en KDE con plasma-apply-wallpaperimage: $path" >&2
    if plasma-apply-wallpaperimage "$path" >/dev/null 2>&1; then
        return 0
    fi

    return 1
}

apply_xfce() {

    local path="$1"

    if ! command -v xfconf-query >/dev/null 2>&1; then
        return 1
    fi

    echo "$LOG_PREFIX aplicando fondo en XFCE con xfconf-query: $path" >&2

    local props
    props=$(xfconf-query -c xfce4-desktop -l 2>/dev/null | grep -E "last-image|image-path" || true)

    if [ -n "$props" ]; then
        while IFS= read -r prop; do
            [ -n "$prop" ] && xfconf-query -c xfce4-desktop -p "$prop" -s "$path" 2>/dev/null || true
        done <<< "$props"
        return 0
    fi

    xfconf-query -c xfce4-desktop -p /backdrop/screen0/monitor0/workspace0/last-image -s "$path" 2>/dev/null || true
    return 0
}

apply() {

    local path="$1"

    if [ -z "$path" ] || [ ! -f "$path" ]; then
        echo "$LOG_PREFIX archivo no existe: $path" >&2
        return 1
    fi

    # Si estamos en sesión KDE o plasmashell está activo
    if [ "${XDG_CURRENT_DESKTOP:-}" = "KDE" ] || [ "${XDG_SESSION_DESKTOP:-}" = "plasma" ] || pgrep -x plasmashell >/dev/null 2>&1; then
        if apply_kde "$path"; then
            return 0
        fi
    fi

    # Si estamos en sesión XFCE o xfconf-query está activo
    if [ "${XDG_CURRENT_DESKTOP:-}" = "XFCE" ] || pgrep -x xfce4-session >/dev/null 2>&1; then
        if apply_xfce "$path"; then
            return 0
        fi
    fi

    # Con Noctalia en marcha no hay otro pintor. Un IPC fallido no cae en
    # swaybg ni en awww: el fondo de Noctalia y swaybg se pisan.
    if noctalia_running; then
        apply_noctalia "$path"
        return $?
    fi

    if command -v swaybg >/dev/null 2>&1; then

        if apply_swaybg "$path"; then
            return 0
        fi

        echo "$LOG_PREFIX swaybg fallo, probando awww..." >&2
    fi

    if command -v awww >/dev/null 2>&1; then

        if apply_awww "$path"; then
            return 0
        fi
    fi

    # Fallback para KDE si los anteriores no aplicaron
    if command -v plasma-apply-wallpaperimage >/dev/null 2>&1; then
        if apply_kde "$path"; then
            return 0
        fi
    fi

    # Fallback para XFCE si los anteriores no aplicaron
    if command -v xfconf-query >/dev/null 2>&1; then
        if apply_xfce "$path"; then
            return 0
        fi
    fi

    echo "$LOG_PREFIX NINGUN backend pudo aplicar $path" >&2
    return 1
}

# Un argumento explícito, aunque sea "", no es "sin argumentos": apply()
# imprime el error y el proceso tiene que salir con ese código.
if [ "$#" -gt 0 ]; then
    apply "$1"
    exit $?
fi

if [ -f "$SETTINGS_FILE" ]; then

    PATH_SAVED=$(SETTINGS_FILE="$SETTINGS_FILE" python3 -c "
import json, os, sys
try:
    with open(os.environ['SETTINGS_FILE']) as f:
        d = json.load(f)
    print(d.get('wallpaper', {}).get('path', ''))
except Exception:
    print('')
" 2>/dev/null || true)

    if [ -n "$PATH_SAVED" ]; then
        if apply "$PATH_SAVED"; then
            exit 0
        fi
    fi
fi

DEFAULT="/usr/share/churros/wallpapers/default.png"

if [ -f "$DEFAULT" ]; then
    apply "$DEFAULT"
    exit $?
fi

echo "$LOG_PREFIX archivo no existe:" >&2
exit 1