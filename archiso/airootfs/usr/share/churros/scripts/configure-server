#!/usr/bin/env bash
#
# configure-server — deja el sistema instalado sin escritorio.
#
# Se ejecuta desde el paso shellprocess@post-install de Calamares, en el
# sistema ya instalado, y solo hace algo si la edición es `server`.
#
# Por qué existe: la ISO de la edición server lleva un escritorio mínimo
# porque Calamares es gráfico y necesita una sesión donde dibujar la
# ventana del instalador. Ese escritorio no tiene sentido en el destino, así
# que aquí se quita.
#
# Las invariantes de arranque, paquetes y servicios son obligatorias. Solo la
# limpieza cosmética es tolerante a fallos.

set -euo pipefail

LOG=/var/log/churros-server.log

log() {
    printf '%s %s\n' "$(date -Is)" "$*" >> "$LOG" 2>/dev/null || true
    printf 'configure-server: %s\n' "$*" >&2
}


# Escribe una regla 22/tcp en un user.rules de ufw, sin invocar `ufw`
# (en el chroot de Calamares, `ufw allow` toca netfilter del Live).
# Idempotente: si la regla ya está, no hace nada.
ufw_insert_allow_22_tcp() {
    local file="$1" chain="$2" addr="$3"
    [ -f "$file" ] || return 1
    grep -qE -- '--dport 22 .*-j ACCEPT' "$file" && return 0
    grep -q '^### RULES ###' "$file" || return 1
    local tmp
    tmp="$(mktemp)" || return 1
    awk -v chain="$chain" -v addr="$addr" '
        { print }
        $0 == "### RULES ###" {
            print ""
            print "### tuple ### allow tcp 22 " addr " any " addr " in"
            print "-A " chain " -p tcp --dport 22 -j ACCEPT"
        }
    ' "$file" > "$tmp" || { rm -f "$tmp"; return 1; }
    cat "$tmp" > "$file" || { rm -f "$tmp"; return 1; }
    rm -f "$tmp"
}

# ------------------------------------------------------------- solo server

EDITION=""
if [ -f /etc/churros-edition ]; then
    EDITION="$(tr -d '[:space:]' < /etc/churros-edition | tr '[:upper:]' '[:lower:]')"
fi

if [ "$EDITION" != "server" ]; then
    exit 0
fi

log "edición server detectada; dejando el sistema sin escritorio"

# ------------------------------------------------- 1. arranque sin gráficos

# greetd y graphical.target los habilita el módulo services-systemd de
# Calamares, con mandatory: true. Aquí se revierten.
systemctl disable greetd.service >> "$LOG" 2>&1
systemctl set-default multi-user.target >> "$LOG" 2>&1
# getty@tty1 lo enmascara el Live (services.sh) para que greetd sea el
# único login, y services-systemd.conf vuelve a enmascararlo en el
# sistema instalado de todas las ediciones. En Server no hay greeter:
# sin quitar la máscara, tty1 queda en negro y hay que ir a tty2.
systemctl unmask getty@tty1.service >> "$LOG" 2>&1
systemctl enable getty@tty1.service >> "$LOG" 2>&1
# El Live también enmascara plymouth-quit y plymouth-quit-wait para que el
# splash no desaparezca antes del greeter; greetd lo apaga con
# ExecStartPre. Esa máscara pasa al instalado. En Server no hay greetd,
# el kernel arranca con `splash` y plymouth se queda dueño de tty1: se
# come las teclas y pinta encima del login. getty@.service ya espera a
# plymouth-quit-wait, así que basta con quitar esas máscaras.
# plymouth-start se queda enmascarado: el initramfs ya lanza plymouth.
systemctl unmask plymouth-quit.service plymouth-quit-wait.service >> "$LOG" 2>&1
log "display manager desactivado; getty@tty1 activo; plymouth suelta tty1; target por defecto multi-user"

# ---------------------------------------------------- 2. quitar escritorio

# Escritorio de la ISO (XFCE), que solo estaba para el instalador.
#
# pacman -R rechaza la transacción entera si un paquete que se queda depende
# de uno que se quita ("removing xfconf breaks dependency 'xfconf' required by
# xfwm4"), y entonces no quita nada. Por eso la lista lleva también los
# paquetes de packages.server.x86_64 que dependen de los de escritorio:
# xfwm4 (xfconf), thunar-archive-plugin y thunar-volman (thunar) y gvfs-mtp
# (gvfs). libxfce4ui, exo, garcon y greetd-agreety no se listan: son
# dependencias, no paquetes explícitos, y -s los quita solo.
DESKTOP_PKGS="xfce4-session xfce4-panel xfce4-settings xfce4-notifyd \
xfce4-power-manager xfce4-pulseaudio-plugin xfce4-screenshooter \
xfce4-taskmanager xfce4-terminal xfce4-whiskermenu-plugin xfconf xfdesktop \
    xfwm4 mousepad ristretto xfce4-screensaver picom redshift \
thunar thunar-archive-plugin thunar-volman gvfs gvfs-mtp \
cage greetd greetd-regreet"

# Las apps propias son binarios en /usr/bin, no paquetes: se borran aparte.
CHURROS_APPS="/usr/bin/churros-welcome /usr/bin/churros-settings \
/usr/bin/churros-control-center /usr/bin/churros-popup /usr/bin/churros-tour \
/usr/bin/churros-apply-wallpaper /usr/bin/churros-pick-image"

installed_desktop=()
for package in $DESKTOP_PKGS; do
    if pacman -Qq "$package" >/dev/null 2>&1; then
        installed_desktop+=("$package")
    fi
done
if [ "${#installed_desktop[@]}" -gt 0 ]; then
    log "quitando paquetes de escritorio: ${installed_desktop[*]}"
    pacman -Rns --noconfirm "${installed_desktop[@]}" >> "$LOG" 2>&1
fi

for app in $CHURROS_APPS; do
    [ -e "$app" ] || continue
    rm -f "$app" || log "no se pudo borrar $app"
done
log "apps propias de escritorio retiradas"

# Los accesos directos del panel de XFCE apuntan a esos binarios.
rm -rf /home/*/.config/xfce4/panel/launcher-* 2>/dev/null || true

# ------------------------------------------------------ 3. servicios servidor

# sshd y chrony solo se habilitan aquí: en una edición de escritorio no tiene
# sentido dejar SSH escuchando a nadie.
systemctl enable sshd.service >> "$LOG" 2>&1
systemctl enable chronyd.service >> "$LOG" 2>&1
systemctl enable NetworkManager.service >> "$LOG" 2>&1
systemctl enable ufw.service >> "$LOG" 2>&1
systemctl enable churros-update.timer >> "$LOG" 2>&1

# Cortafuegos real, sin invocar `ufw` en este paso. El script corre en el
# chroot de Calamares, con /proc y /sys del Live montados: `ufw allow` y
# `ufw enable` aplicarían reglas (o dejarían tablas filter vacías) en el
# kernel del instalador. Escribimos 22/tcp en user.rules y, si IPV6=yes
# en /etc/default/ufw (no en ufw.conf), también en user6.rules. ENABLED=yes
# en ufw.conf hace que ufw.service, ya habilitado, cargue esas reglas en
# el primer arranque. Sin la regla no se escribe ENABLED=yes: la política
# por defecto es DROP y se perdería el acceso por SSH.
if [ -f /etc/ufw/ufw.conf ]; then
    if ufw_insert_allow_22_tcp /etc/ufw/user.rules ufw-user-input '0.0.0.0/0' \
        && grep -qE -- '--dport 22 .*-j ACCEPT' /etc/ufw/user.rules \
        && { ! grep -qE '^IPV6=["'"'"']?yes["'"'"']?$' /etc/default/ufw \
             || { ufw_insert_allow_22_tcp /etc/ufw/user6.rules ufw6-user-input '::/0' \
                  && grep -qE -- '--dport 22 .*-j ACCEPT' /etc/ufw/user6.rules; }; }; then
        sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
        if grep -q '^ENABLED=yes$' /etc/ufw/ufw.conf; then
            log "ufw: regla 22/tcp añadida y ENABLED=yes (se carga en el primer arranque)"
        else
            log "no se pudo escribir ENABLED=yes; el cortafuegos no se activará al arrancar"
        fi
    else
        log "no se pudo añadir la regla 22/tcp; no se activa el cortafuegos"
    fi
else
    log "falta /etc/ufw/ufw.conf; no se activa el cortafuegos"
fi

log "sshd, chronyd, NetworkManager, ufw y churros-update.timer habilitados"

# --------------------------------------------------------- 4. restos de config

rm -f /etc/greetd/environments 2>/dev/null || true
rm -rf /home/*/.config/autostart 2>/dev/null || true
sed -i '/spawn-at-startup/d; /churros-welcome/d; /churros-tour/d' \
    /etc/skel/.config/niri/config.kdl /home/*/.config/niri/config.kdl 2>/dev/null || true

# El skel ya no debe propagar un escritorio ni el timer de usuario redundante.
rm -rf /etc/skel/.config/xfce4 2>/dev/null || true
rm -f /etc/skel/.config/autostart/*.desktop 2>/dev/null || true
# Server usa churros-update.timer de sistema (habilitado arriba). El timer de
# usuario heredado del skel no tiene agente polkit en sesión server (#328).
rm -f /etc/skel/.config/systemd/user/timers.target.wants/churros-update.timer \
      /etc/skel/.config/systemd/user/churros-update.timer 2>/dev/null || true
rm -f /home/*/.config/systemd/user/timers.target.wants/churros-update.timer 2>/dev/null || true

log "limpieza de configuración del escritorio completada"
log "resumen: servidor sin display manager, con SSH, cortafuegos y sincronización horaria"
exit 0
