#!/usr/bin/env bash
set -euo pipefail

REGREET_CONF="/etc/greetd/regreet.toml"
[ -f "$REGREET_CONF" ] || exit 0

LANG_CODE="en"
if [ -f /etc/locale.conf ]; then
    RAW_LANG="$(grep '^LANG=' /etc/locale.conf 2>/dev/null | cut -d= -f2 | tr -d '"'\'' ')"
    if [ -n "$RAW_LANG" ]; then
        LANG_CODE="$(echo "$RAW_LANG" | cut -d_ -f1 | tr '[:upper:]' '[:lower:]')"
    fi
fi

case "$LANG_CODE" in
    es)
        GREET="Bienvenido a ChurrOS"
        DATE="%A, %-d de %B"
        ;;
    pt)
        GREET="Bem-vindo ao ChurrOS"
        DATE="%A, %-d de %B"
        ;;
    fr)
        GREET="Bienvenue sur ChurrOS"
        DATE="%A %-d %B"
        ;;
    de)
        GREET="Willkommen bei ChurrOS"
        DATE="%A, %-d. %B"
        ;;
    it)
        GREET="Benvenuto su ChurrOS"
        DATE="%A %-d %B"
        ;;
    *)
        GREET="Welcome to ChurrOS"
        DATE="%A, %B %-d"
        ;;
esac

sed -i "s|^greeting_msg = .*|greeting_msg = \"$GREET\"|" "$REGREET_CONF" || true

# The clock is Pango markup (regreet.toml): only the strftime date between the
# first <span ...> and </span> changes. awk reads it from the environment, so
# the quotes and the "\n" of the TOML string pass through untouched.
DATE="$DATE" awk '
    /^format = "<span[^>]*>/ && index($0, "</span>") {
        open = substr($0, 1, index($0, ">"))
        rest = substr($0, index($0, "</span>"))
        print open ENVIRON["DATE"] rest
        next
    }
    { print }
' "$REGREET_CONF" > "$REGREET_CONF.tmp" && cat "$REGREET_CONF.tmp" > "$REGREET_CONF"
rm -f "$REGREET_CONF.tmp"
