#!/usr/bin/env bash
set -euo pipefail

REGREET_CONF="/etc/greetd/regreet.toml"
[ -f "$REGREET_CONF" ] || exit 0

LANG_CODE="en"
if [ -f /etc/locale.conf ]; then
    RAW_LANG="$(grep '^LANG=' /etc/locale.conf 2>/dev/null | cut -d= -f2 | tr -d '"'\'' ')"
    if [ -n "$RAW_LANG" ]; then
        LANG_CODE="$(echo "$RAW_LANG" | cut -d_ -f1 | tr '[:upper:]' '[:lower:]')"
    fi
fi

case "$LANG_CODE" in
    es)
        GREET="Bienvenido a ChurrOS"
        DATE="%A, %-d de %B"
        ;;
    pt)
        GREET="Bem-vindo ao ChurrOS"
        DATE="%A, %-d de %B"
        ;;
    fr)
        GREET="Bienvenue sur ChurrOS"
        DATE="%A %-d %B"
        ;;
    de)
        GREET="Willkommen bei ChurrOS"
        DATE="%A, %-d. %B"
        ;;
    it)
        GREET="Benvenuto su ChurrOS"
        DATE="%A %-d %B"
        ;;
    *)
        GREET="Welcome to ChurrOS"
        DATE="%A, %B %-d"
        ;;
esac

sed -i "s|^greeting_msg = .*|greeting_msg = \"$GREET\"|" "$REGREET_CONF" || true

# The clock (Pango markup in regreet.toml) is generated by the same helper
# Settings uses, from /etc/greetd/churros-greeter.conf: only the date
# pattern changes with the language.
/usr/local/bin/churros-write-root-config greeter-set "date_pattern=$DATE" || true
