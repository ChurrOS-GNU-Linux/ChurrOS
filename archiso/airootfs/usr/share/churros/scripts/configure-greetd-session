#!/usr/bin/env bash
# Configure greetd session for the installed system.
# Called from Calamares shellprocess-cleanup after Calamares displaymanager module.
#
# - Calamares displaymanager natively writes /etc/greetd/config.toml, but it uses
#   'agreety' as the default session and doesn't handle XFCE editions properly.
# - We extract the autologin user (if any) that Calamares carefully configured.
# - We rewrite the config.toml to use our graphical regreet GTK theme.
# - We correctly enforce the session command of the installed edition (niri,
#   churros-xfce-session or startplasma-wayland). The edition -> session table lives in
#   edition-session.sh, shared with churros-write-root-config (autologin from
#   Settings), so both write the same [initial_session].

set -euo pipefail

# shellcheck source=edition-session.sh
. /usr/share/churros/scripts/edition-session.sh

GREETD_CONF="/etc/greetd/config.toml"

# En la edición server el sistema instalado no tiene display manager:
# configure-server lo quita y deja el arranque en multi-user.
SESSION_CMD="$(churros_session_command "$(churros_edition)")" || exit 0

# XFCE: ReGreet no usa SESSION_CMD, descubre las sesiones en /usr/share/*sessions
# y lanza xfce.desktop como `startx /usr/bin/env <Exec>`. El paquete trae
# Exec=startxfce4 (sin wrapper) y una sesión xfce-wayland que exige labwc; el
# parche de desktop.sh solo existe en el Live, no en el sistema instalado.
# Sin esto el login sin inicio automático vuelve al greeter en bucle.
if [ "$(churros_edition)" = "xfce" ] && [ -x /usr/share/churros/scripts/fix-xfce-sessions ]; then
    /usr/share/churros/scripts/fix-xfce-sessions
fi

# Extract the autologin user that Calamares displaymanager wrote
AUTOLOGIN_USER=""
if [ -f "$GREETD_CONF" ]; then
    if grep -q "\[initial_session\]" "$GREETD_CONF"; then
        AUTOLOGIN_USER="$(grep -A 5 '\[initial_session\]' "$GREETD_CONF" | grep '^user *=' | head -1 | cut -d '=' -f 2 | tr -d ' "' || true)"
    fi
fi

# Write our preferred greetd config (with the fixed autologin block if a user
# was found)
mkdir -p "$(dirname "$GREETD_CONF")"
churros_greetd_config "$SESSION_CMD" "$AUTOLOGIN_USER" > "$GREETD_CONF"

if [ -n "$AUTOLOGIN_USER" ]; then
    echo "[greetd] Autologin enabled for user '$AUTOLOGIN_USER' with session '$SESSION_CMD'"
else
    echo "[greetd] No autologin — regreet greeter will prompt for credentials"
fi

# Write environments file so regreet knows which sessions are available
echo "$SESSION_CMD" > /etc/greetd/environments
