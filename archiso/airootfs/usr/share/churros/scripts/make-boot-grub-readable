#!/usr/bin/env bash
#
# GRUB cannot reliably read zstd-compressed or sparse files from btrfs.
# That shows up as: premature end of file /@/boot/vmlinuz-linux
# (then "you need to load the kernel first" for the initramfs).
#
# Mark /boot No_COW + compression=none. Rewrite each image into a new
# empty +C inode with a full copy. `cp -a` on btrfs reflinks by default
# and keeps the compressed extents, so GRUB still fails.
# A pacman hook re-runs this after kernel/initramfs updates.

set -euo pipefail

# En aarch64 publica vmlinuz-linux-aarch64 antes de salir: en ext4 este
# script no reescribe inodos, pero GRUB sigue necesitando ese nombre.
# En x86_64 no hay /boot/Image y el script sale 0.
if [ -x /usr/share/churros/scripts/publish-aarch64-kernel ]; then
    /usr/share/churros/scripts/publish-aarch64-kernel
fi

root_fstype="$(findmnt -n -o FSTYPE / 2>/dev/null || true)"
boot_fstype="$(findmnt -n -o FSTYPE /boot 2>/dev/null || true)"
if [ "$root_fstype" != btrfs ] && [ "$boot_fstype" != btrfs ]; then
    exit 0
fi
case "$boot_fstype" in
    vfat|fat|msdos|exfat)
        exit 0
        ;;
esac

if [ -d /boot ]; then
    command -v btrfs >/dev/null 2>&1 || {
        echo "make-boot-grub-readable: falta btrfs para proteger /boot" >&2
        exit 1
    }
    chattr +C /boot
    btrfs property set /boot compression none
    lsattr -d /boot | awk '{print $1}' | grep -q C || {
        echo "make-boot-grub-readable: /boot no tiene el atributo No_COW" >&2
        exit 1
    }
    btrfs property get /boot compression | grep -Eq 'compression[= ]+none' || {
        echo "make-boot-grub-readable: la compresión de /boot sigue activa" >&2
        exit 1
    }
fi

# chattr +C only applies to a newly created empty file. Write into that
# inode (dd, never reflink/sparse) and rename over the original.
rewrite_for_grub() {
    local f=$1
    local tmp="${f}.grub-rewr"

    rm -f -- "$tmp"
    touch -- "$tmp"
    chattr +C -- "$tmp"
    dd if="$f" of="$tmp" bs=8M status=none conv=fsync
    chmod --reference="$f" "$tmp"
    chown --reference="$f" "$tmp"
    mv -f -- "$tmp" "$f"
    lsattr -d -- "$f" | awk '{print $1}' | grep -q C || {
        echo "make-boot-grub-readable: $f no tiene el atributo No_COW" >&2
        return 1
    }
}

shopt -s nullglob

# Rewrite kernel, initramfs, microcode
for f in /boot/vmlinuz-* /boot/initramfs-*.img /boot/*-ucode.img; do
    [ -f "$f" ] || continue
    case "$f" in
        *.grub-rewr) continue ;;
    esac
    rewrite_for_grub "$f"
done

# Rewrite GRUB theme assets (background, fonts, select*.png, theme.txt)
THEME_DIR="/boot/grub/themes/churros"
if [ -d "$THEME_DIR" ]; then
    for f in "$THEME_DIR"/background.png "$THEME_DIR"/*.pf2 "$THEME_DIR"/select*.png "$THEME_DIR"/theme.txt; do
        [ -f "$f" ] || continue
        case "$f" in
            *.grub-rewr) continue ;;
        esac
        rewrite_for_grub "$f"
    done
fi
