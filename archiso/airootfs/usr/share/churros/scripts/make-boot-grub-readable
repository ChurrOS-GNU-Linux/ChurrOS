#!/usr/bin/env bash
#
# GRUB cannot reliably read zstd-compressed or sparse files from btrfs.
# That shows up as: premature end of file /@/boot/vmlinuz-linux
# (then "you need to load the kernel first" for the initramfs).
#
# Mark /boot No_COW + no compression (chattr +C +m). Rewrite each image into a new
# empty +C inode with a full copy. `cp -a` on btrfs reflinks by default
# and keeps the compressed extents, so GRUB still fails.
# A pacman hook re-runs this after kernel/initramfs updates.
#
# CHURROS_ROOT lets tests run it against a scratch tree instead of /.

set -Eeuo pipefail

# Calamares (shellprocess@grub-theme) only shows stdout: an error on stderr
# turned into "exit code 1, there was no output from the command".
exec 2>&1
trap 'printf "make-boot-grub-readable: falló la línea %s: %s (código %s)\n" "$LINENO" "$BASH_COMMAND" "$?"' ERR

ROOT="${CHURROS_ROOT:-}"
BOOT="$ROOT/boot"

fail() {
    printf 'make-boot-grub-readable: %s\n' "$*"
    exit 1
}

# En aarch64 publica vmlinuz-linux-aarch64 antes de salir: en ext4 este
# script no reescribe inodos, pero GRUB sigue necesitando ese nombre.
# En x86_64 no hay /boot/Image y el script sale 0.
if [ -x "$ROOT/usr/share/churros/scripts/publish-aarch64-kernel" ]; then
    CHURROS_ROOT="$ROOT" "$ROOT/usr/share/churros/scripts/publish-aarch64-kernel"
fi

# Only the filesystem that really holds /boot matters: a separate ext4 /boot
# under a btrfs root (or the ESP) does not know No_COW and chattr +C fails
# there. stat -f answers for the directory itself, mountpoint or not, also
# inside the Calamares chroot.
[ -d "$BOOT" ] || exit 0
boot_fs="$(stat -f -c %T "$BOOT" 2>/dev/null || true)"
[ "$boot_fs" = btrfs ] || exit 0

# No pipeline: with pipefail, `lsattr | awk | grep -q` can fail on SIGPIPE.
has_nocow() {
    local attrs
    attrs="$(lsattr -d -- "$1" 2>&1)" || return 1
    case "${attrs%% *}" in
        *C*) return 0 ;;
    esac
    return 1
}

# +C (No_COW) already rules out compression; +m makes it explicit.
# Never `btrfs property set /boot compression ...`: on a No_COW inode
# the kernel rejects it with EINVAL and Calamares aborts the install.
# Fall back to +C alone if this chattr/kernel does not know +m.
# btrfs answers EINVAL when +C/+m are set again on an inode that already
# has them: shellprocess@boot-nocow marks /boot before unpackfs, and the
# pacman hook runs this on every kernel update. Only chattr when missing.
if ! has_nocow "$BOOT"; then
    chattr +C +m "$BOOT" 2>/dev/null || chattr +C "$BOOT" || fail "no se pudo marcar $BOOT con chattr +C"
fi
has_nocow "$BOOT" || fail "$BOOT no tiene el atributo No_COW"

# chattr +C only applies to a newly created empty file. Write into that
# inode (dd, never reflink/sparse) and rename over the original.
rewrite_for_grub() {
    local f=$1
    local tmp="${f}.grub-rewr"

    rm -f -- "$tmp"
    touch -- "$tmp"
    # The new inode inherits +C (and +m) from /boot. btrfs rejects setting
    # flags on a regular file that has both: an unconditional `chattr +C`
    # here failed with EINVAL ("Invalid argument") and aborted the install.
    # Only call chattr when the flag is really missing.
    has_nocow "$tmp" || chattr +C -- "$tmp" || fail "no se pudo marcar $tmp con chattr +C"
    has_nocow "$tmp" || fail "$tmp no tiene el atributo No_COW"
    dd if="$f" of="$tmp" bs=8M status=none conv=fsync
    chmod --reference="$f" "$tmp"
    chown --reference="$f" "$tmp"
    mv -f -- "$tmp" "$f"
    has_nocow "$f" || fail "$f no tiene el atributo No_COW"
}

# Symlinks stay symlinks: fix-boot points vmlinuz-linux and
# initramfs-linux.img at the CachyOS images. Rewriting the link replaced it
# with a copy of the image, which the next kernel update left stale. Its
# target is rewritten under its own name.
rewrite_all() {
    local f
    for f in "$@"; do
        [ -L "$f" ] && continue
        [ -f "$f" ] || continue
        case "$f" in
            *.grub-rewr) continue ;;
        esac
        rewrite_for_grub "$f"
    done
}

shopt -s nullglob

# Kernel, initramfs, microcode
rewrite_all "$BOOT"/vmlinuz-* "$BOOT"/initramfs-*.img "$BOOT"/*-ucode.img

# GRUB theme assets (background, fonts, select*.png, theme.txt)
THEME_DIR="$BOOT/grub/themes/churros"
if [ -d "$THEME_DIR" ]; then
    rewrite_all "$THEME_DIR"/background.png "$THEME_DIR"/*.pf2 "$THEME_DIR"/select*.png "$THEME_DIR"/theme.txt
fi
