#!/usr/bin/env bash
# Aplica el logo de ChurrOS al botón Kickoff de KDE Plasma
set -euo pipefail

CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/plasma-org.kde.plasma.desktop-appletsrc"
[ -f "$CONFIG_FILE" ] || exit 0

if command -v kwriteconfig6 >/dev/null 2>&1; then
    # Read the actual nested KConfig section, including the containment ID.
    # Materialize the IDs before kwriteconfig6 changes the file being read.
    applets=$(awk '
        /^\[/ {
            containment = ""; applet = ""
            if ($0 ~ /^\[Containments\]\[[0-9]+\]\[Applets\]\[[0-9]+\]$/) {
                split($0, groups, /[][]/)
                containment = groups[4]; applet = groups[8]
            }
        }
        /^plugin=org\.kde\.plasma\.kickoff$/ && applet != "" {
            print containment ":" applet
        }
    ' "$CONFIG_FILE")
    while IFS=: read -r containment_id applet_id; do
        [ -n "$applet_id" ] || continue
        groups=(--file "$CONFIG_FILE" --group Containments --group "$containment_id"
            --group Applets --group "$applet_id" --group Configuration --group General)
        kwriteconfig6 "${groups[@]}" --key icon "churros-logo"
        kwriteconfig6 "${groups[@]}" --key useCustomButtonImage "true"
        kwriteconfig6 "${groups[@]}" --key customButtonImage "/usr/share/icons/hicolor/scalable/apps/churros-logo.svg"
    done <<< "$applets"
fi
