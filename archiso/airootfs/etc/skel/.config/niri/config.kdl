// Environment
environment {
    QT_QPA_PLATFORM "wayland"
    GDK_BACKEND "wayland"
    MOZ_ENABLE_WAYLAND "1"
}

// Cursor
cursor {
    xcursor-size 24
}

// Ask windows to omit client-side decorations
prefer-no-csd

// Blur
blur {
    passes 3
    offset 3
    noise 0
    saturation 1.3
}

// Input
input {
    keyboard {
        xkb {
            layout "us"
        }
    }
}

// Layout
layout {
    gaps 8
    focus-ring {
        off
    }
    border {
        on
        width 2
        active-color "#DE8636"
        inactive-color "#766561"
    }
}

// Window rules
window-rule {
    match app-id="pavucontrol"
    open-floating true
}

window-rule {
    match app-id="foot"
    opacity 0.8
    draw-border-with-background false
    background-effect {
        blur true
    }
}

window-rule {
    match app-id="fuzzel"
    opacity 0.92
    background-effect {
        blur true
    }
    geometry-corner-radius 0
    clip-to-geometry true
}

window-rule {
    match app-id="mako"
    opacity 0.92
    background-effect {
        blur true
    }
    geometry-corner-radius 0
    clip-to-geometry true
}

window-rule {
    match app-id="firefox"
    match title="^Picture-in-Picture$"
    open-floating true
}

// Ajustes de Noctalia (en v5 son una ventana propia): flotante y con el tamaño
// que elige la app, como el panel de ajustes de la v4.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
}

// Apps de ChurrOS: glassmorphism — la transparencia sale del alpha del
// fondo en CSS (GTK no soporta backdrop-filter); el blur real lo hace
// el compositor con background-effect blur true.
//
// El bloque entre [CHURROS-GLASS-START] y [CHURROS-GLASS-END] lo
// gestiona churros-settings (Modo rendimiento): la app cambia
// blur true <-> blur false dentro de estos marcadores para
// activar/desactivar el blur sin tocar el resto del config.
// [CHURROS-GLASS-START]
window-rule {
    match app-id=r#"^org\.churros\.popup"#
    open-floating true
    opacity 0.9
    draw-border-with-background false
    background-effect {
        blur true
    }
    geometry-corner-radius 20
    clip-to-geometry true
}

window-rule {
    match app-id="org.churros.controlcenter"
    open-floating true
    opacity 0.9
    draw-border-with-background false
    background-effect {
        blur true
    }
    geometry-corner-radius 22
    clip-to-geometry true
}

window-rule {
    match app-id="org.churros.preferences"
    opacity 0.9
    draw-border-with-background false
    background-effect {
        blur true
    }
    geometry-corner-radius 16
    clip-to-geometry true
}

window-rule {
    match app-id="org.churros.welcome"
    opacity 0.9
    draw-border-with-background false
    background-effect {
        blur true
    }
    geometry-corner-radius 18
    clip-to-geometry true
}

window-rule {
    match app-id="org.churros.tour"
    open-floating true
    opacity 0.9
    draw-border-with-background false
    background-effect {
        blur true
    }
    geometry-corner-radius 18
    clip-to-geometry true
}
// [CHURROS-GLASS-END]

// Layer rules
layer-rule {
    match namespace="^launcher$"
    background-effect {
        blur true
    }
}

// El overlay de Niri pone en inglés las acciones que no llevan título, y
// también las que no están asignadas. hide-not-bound deja solo las reales.
hotkey-overlay {
    hide-not-bound true
}

// Keybindings
binds {

    // Launch. Los títulos del overlay son los que muestra Mod+Shift+/.
    // IPC de Noctalia 5.2.1: `noctalia msg panel-toggle <id>`.
    Mod+Return hotkey-overlay-title="Abrir la terminal" { spawn "foot"; }
    Mod+Q hotkey-overlay-title="Cerrar la ventana" { close-window; }
    Mod+Shift+M hotkey-overlay-title="Salir de Niri" { quit; }
    Mod+F hotkey-overlay-title="Maximizar la columna" { maximize-column; }
    Mod+Shift+F hotkey-overlay-title="Pantalla completa" { fullscreen-window; }
    Mod+Space hotkey-overlay-title="Abrir el lanzador" { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+Shift+Space hotkey-overlay-title="Lanzador alternativo (Fuzzel)" { spawn "fuzzel"; }

    // ChurrOS apps. El centro de control de Noctalia ya cubre red, audio,
    // bluetooth, brillo y batería. churros-popup y churros-control-center
    // siguen en la ISO y se abren desde el lanzador, sin atajo en esta sesión.
    Mod+C hotkey-overlay-title="Abrir el centro de control" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+P hotkey-overlay-title="Abrir ajustes" { spawn "churros-settings"; }
    Mod+W hotkey-overlay-title="Abrir la bienvenida" { spawn "churros-welcome"; }
    Mod+S hotkey-overlay-title="Abrir la tienda" { spawn "bazaar"; }
    Mod+E hotkey-overlay-title="Abrir archivos" { spawn "thunar"; }
    Mod+Shift+E hotkey-overlay-title="Menú de sesión" { spawn "wlogout"; }

    // Escape hatch
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Alternar el bloqueo de atajos" { toggle-keyboard-shortcuts-inhibit; }

    // Overlay & overview
    Mod+Shift+Slash hotkey-overlay-title="Mostrar los atajos" { show-hotkey-overlay; }
    Mod+O hotkey-overlay-title="Abrir la vista general" { toggle-overview; }

    // Layout
    Mod+R hotkey-overlay-title="Cambiar el ancho de columna" { switch-preset-column-width; }
    Mod+V hotkey-overlay-title="Alternar ventana flotante" { toggle-window-floating; }
    Mod+Shift+V hotkey-overlay-title="Cambiar entre flotante y mosaico" { switch-focus-between-floating-and-tiling; }

    // Screenshots
    Print hotkey-overlay-title="Capturar la pantalla" { screenshot; }
    Ctrl+Print hotkey-overlay-title="Capturar toda la pantalla" { screenshot-screen; }
    Alt+Print hotkey-overlay-title="Capturar la ventana" { screenshot-window; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    // Focus movement. Izquierda y derecha salen en el overlay de Niri;
    // arriba y abajo no, y un título las añadiría a la lista.
    Mod+Left hotkey-overlay-title="Enfocar la columna izquierda" { focus-column-left; }
    Mod+Right hotkey-overlay-title="Enfocar la columna derecha" { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }

    // Window movement
    Mod+Shift+Left hotkey-overlay-title="Mover la columna a la izquierda" { move-column-left; }
    Mod+Shift+Right hotkey-overlay-title="Mover la columna a la derecha" { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }

    // Media keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }
}

// Autostart. El fondo lo pinta solo Noctalia ([wallpaper.default] en
// ~/.config/noctalia/config.toml). swaybg sigue instalado como respaldo
// fuera de esta sesión, pero no se arranca aquí: si no, se superpone.
spawn-at-startup "churros-portal-start"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "noctalia"
spawn-at-startup "churros-welcome"
spawn-sh-at-startup "[ -f ~/.config/autostart/churros-tour.desktop ] && churros-tour"