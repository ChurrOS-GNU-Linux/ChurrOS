// Autorización de ejecución privilegiada (pkexec) para los usuarios de `wheel`.
//
// QUÉ PUBLICA PKEXEC
// La acción `org.freedesktop.policykit.exec` llega con estos detalles
// (comprobado con polkitd 124 y en el código de pkexec):
//   program       ruta absoluta del ejecutable; desde polkit 127, su realpath
//   command_line  argv unido con espacios, empezando por la ruta llamada
//   user          usuario destino: root salvo con `pkexec --user`
// No existe un detalle `command` ni `action.getDetails()`. La versión anterior
// de esta regla los leía y por eso no autorizaba nunca nada (#152).
// scripts/test-polkit-rules.js fija este contrato y la tabla de abajo.
//
// REGLA DE ORO: autorizar por RUTA ABSOLUTA exacta, nunca por basename ni por
// comodín de nombre. pkexec resuelve rutas relativas (`./x`, `../x`) y busca
// en $PATH, así que un comodín tipo `^churros-[\w-]+$` sobre el basename
// concede root sin contraseña a cualquier fichero que el usuario pueda crear
// en su home o en un directorio de su $PATH. Todas las rutas de la lista viven
// bajo /usr o /usr/local, propiedad de root. No se autoriza ningún wrapper
// genérico (`churros-pkexec`): reenviaría argumentos libres a pkexec.
//
// QUÉ SE AUTORIZA
// Solo el argv exacto de los llamadores reales (Ajustes y churros-update-auto;
// lista en docs/privileged-execution.md). Los argumentos se comparan como una
// sola cadena contra expresiones ancladas, así que no cabe nada más: ni
// `--opt=valor`, ni `--config`, ni `-H host`, ni un argumento extra.
//
//   programa                                  argumentos                  resultado
//   /usr/local/bin/churros-snapshot           list --json                 YES
//                                             create manual               YES (1)
//                                             delete AAAAMMDD-HHMMSS      AUTH_ADMIN_KEEP
//   /usr/bin/timedatectl                      set-timezone <Zona/Ciudad>  YES
//                                             set-ntp true|false          YES
//   /usr/bin/pacman                           -Syu --noconfirm            AUTH_ADMIN_KEEP
//   /usr/bin/flatpak                          update -y                   AUTH_ADMIN_KEEP
//   /usr/bin/churros-update-utils             (sin argumentos)            AUTH_ADMIN_KEEP
//   /usr/local/bin/churros-write-root-config  greetd-autologin on|off     AUTH_ADMIN_KEEP
//                                             lightdm-autologin on|off    AUTH_ADMIN_KEEP
//                                             regreet-wallpaper <ruta>    AUTH_ADMIN_KEEP
//                                             regreet-greeting <texto>    AUTH_ADMIN_KEEP
//   cualquier otra cosa                                                   NOT_HANDLED
//
// YES: sin contraseña, solo para lo inocuo.
// AUTH_ADMIN_KEEP: contraseña de administrador, que polkit recuerda unos
//   minutos para el mismo proceso. churros-pkexec hace `exec pkexec` para que
//   ese proceso sea la app que llama y la contraseña sirva para varios pasos.
// NOT_HANDLED: política por defecto de pkexec (auth_admin, contraseña cada vez).
// (1) `create` rota los snapshots: conserva los 5 más recientes y borra el
//     resto. Si no se quiere que un proceso del usuario pueda descartar puntos
//     de restauración sin contraseña, hay que pasarlo a AUTH_ADMIN_KEEP.
//
// La regla tiene que seguir siendo ES5 (polkitd usa duktape): ni `let`, ni
// `const`, ni funciones flecha.

polkit.addRule(function(action, subject) {
    // NOTA: no usar subject.active — en sesiones de greetd/niri puede
    // devolver false y pkexec falla sin agente. Se comprueba el grupo
    // wheel (usuarios administradores), que es el criterio estándar.
    if (!subject.local || !subject.isInGroup("wheel")) {
        return polkit.Result.NOT_HANDLED;
    }

    if (action.id == "io.calamares.calamares.pkexec.run" &&
        subject.user == "churros") {
        return polkit.Result.YES;
    }

    if (action.id != "org.freedesktop.policykit.exec") {
        return polkit.Result.NOT_HANDLED;
    }

    var YES = polkit.Result.YES;
    var ADMIN_KEEP = polkit.Result.AUTH_ADMIN_KEEP;

    // Por programa, pares [argumentos, resultado]. `null` significa "sin
    // argumentos"; una expresión regular se compara con los argumentos unidos
    // por espacios, tal como los publica pkexec, y siempre va anclada.
    var ALLOWED = {
        "/usr/local/bin/churros-snapshot": [
            [/^list --json$/, YES],
            [/^create manual$/, YES],
            [/^delete [0-9]{8}-[0-9]{6}$/, ADMIN_KEEP]
        ],
        "/usr/bin/timedatectl": [
            // Nombres de la base tz: componentes alfanuméricos con _ + -,
            // hasta tres niveles (America/Argentina/Buenos_Aires).
            [/^set-timezone [A-Za-z0-9][A-Za-z0-9_+-]*(\/[A-Za-z0-9][A-Za-z0-9_+-]*){0,2}$/, YES],
            [/^set-ntp (true|false)$/, YES]
        ],
        "/usr/bin/pacman": [
            [/^-Syu --noconfirm$/, ADMIN_KEEP]
        ],
        "/usr/bin/flatpak": [
            [/^update -y$/, ADMIN_KEEP]
        ],
        "/usr/bin/churros-update-utils": [
            [null, ADMIN_KEEP]
        ],
        "/usr/local/bin/churros-write-root-config": [
            // El helper valida el valor por su cuenta; aquí solo se acota
            // la operación.
            [/^(greetd|lightdm)-autologin (on|off)$/, ADMIN_KEEP],
            [/^regreet-wallpaper \/.+$/, ADMIN_KEEP],
            [/^regreet-greeting .+$/, ADMIN_KEEP]
        ]
    };

    var prog = action.lookup("program");
    var line = action.lookup("command_line");
    if (typeof prog !== "string" || typeof line !== "string" ||
        !Object.prototype.hasOwnProperty.call(ALLOWED, prog)) {
        return polkit.Result.NOT_HANDLED;
    }

    // Solo para ejecutar como root: `pkexec --user otro` queda fuera.
    if (action.lookup("user") !== "root") {
        return polkit.Result.NOT_HANDLED;
    }

    // command_line empieza por la ruta con la que se llamó al programa. Se
    // exige que sea la misma que `program`; si no (un enlace simbólico
    // resuelto por polkit >= 127, una ruta con espacios), los argumentos no
    // se pueden separar con certeza y no se autoriza nada.
    var args;
    if (line === prog) {
        args = null;
    } else if (line.indexOf(prog + " ") === 0) {
        args = line.substring(prog.length + 1);
    } else {
        return polkit.Result.NOT_HANDLED;
    }

    var entries = ALLOWED[prog];
    for (var i = 0; i < entries.length; i++) {
        var pattern = entries[i][0];
        var match = pattern === null ? args === null
                                     : args !== null && pattern.test(args);
        if (match) {
            return entries[i][1];
        }
    }
    return polkit.Result.NOT_HANDLED;
});
