[Trigger]
Operation = Install
Operation = Upgrade
Operation = Remove
Type = Package
Target = *

[Action]
Description = Creando snapshot btrfs antes de la transacción (rollback de ChurrOS)
When = PreTransaction
Depends = btrfs-progs
Exec = /bin/sh -c '/usr/local/bin/churros-snapshot create pacman-pre || echo "churros-snapshot: AVISO: esta transacción NO tiene snapshot previo; si algo sale mal no se podrá volver atrás (el motivo está justo encima)" >&2'
