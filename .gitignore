*.iso
*.img
*.qcow2
*.log
*.tmp
.cache/
work/
out/
build/
__pycache__/
*.pyc
*.pyo

# Editor / IDE
.vscode/

# QEMU EFI vars (local VM state)
vm/OVMF_VARS.fd

# Misc local notes accidentally committed
session-*.md

# Local pacman repo: built packages and repo databases.
# These are produced by scripts/build-calamares.sh and scripts/build-aur.sh
# and are not part of the source tree — each developer rebuilds them locally.
archiso/packages/*.pkg.tar.*
archiso/packages/churros.db
archiso/packages/churros.db.tar.gz
archiso/packages/churros.db.tar.gz.old
archiso/packages/churros.files
archiso/packages/churros.files.tar.gz
archiso/packages/churros.files.tar.gz.old
archiso/packages/.calamares-build.stamp
archiso/packages/packages
archiso/packages/aarch64/*.pkg.tar.*
archiso/packages/aarch64/churros.db
archiso/packages/aarch64/churros.db.tar.gz
archiso/packages/aarch64/churros.db.tar.gz.old
archiso/packages/aarch64/churros.files
archiso/packages/aarch64/churros.files.tar.gz
archiso/packages/aarch64/churros.files.tar.gz.old
archiso/packages/aarch64/.calamares-build.stamp

# Rust workspace: build artifacts and deployed binaries.
# Produced by scripts/build-rust.sh — binaries land in the airootfs tree
# only during a build and are removed by the cleanup trap.
rust/**/target/
archiso/airootfs/usr/bin/churros-welcome
archiso/airootfs/usr/bin/churros-settings
archiso/airootfs/usr/bin/churros-popup
archiso/airootfs/usr/bin/churros-control-center

# Rust apps' runtime assets copied by scripts/build-rust.sh
archiso/airootfs/usr/share/churros/churros-welcome/
archiso/airootfs/usr/share/churros/churros-settings/
archiso/airootfs/usr/share/churros/churros-popup/
archiso/airootfs/usr/share/churros/churros-control-center/

# Release bundles produced by scripts/build-churros-release.sh
release/

# Temporary airootfs build artifacts (copied during build, removed by cleanup trap)
archiso/airootfs/etc/calamares/
archiso/airootfs/etc/churros-edition
archiso/airootfs/etc/polkit-1/rules.d/49-calamares.rules
archiso/airootfs/root/branding/
archiso/airootfs/root/customize_airootfs.sh
archiso/airootfs/root/packages/
archiso/airootfs/usr/share/churros/grub-theme/

# Build-time backups of versioned files (restored by the cleanup trap)
archiso/packages.*.orig
archiso/airootfs/etc/greetd/config.toml.bak
archiso/airootfs/etc/mkinitcpio.d/linux.preset.x86-stash
archiso/airootfs/etc/mkinitcpio.d/linux-aarch64.preset
archiso/airootfs/etc/mkinitcpio.conf.d/archiso.conf.x86-stash
archiso/airootfs/usr/share/churros/mkinitcpio/
